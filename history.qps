CE_OS_History.

purpose: def"
Authoritative semantic history ledger for CE-OS.

History records accepted accomplishments and capabilities rather than
reproducing Git commit history.

The ledger is global. Directory-local history is produced by filtering
entries by their recorded repository scopes.
";

schema: (
version- "1";

entry_fields: (
timestamp- "machine-readable accepted timestamp";
identity- "stable semantic history identity";
scope- "one or more repository paths associated with the accomplishment";
summary- "concise description suitable for default qps history output";
meaning- "why the accepted work matters";
proof- "accepted proof and validation state";
relevant- "important repository paths";
remaining- "known limitations or intentionally unfinished work";
source_checklist- "Checklist that produced the accepted history entry";
backing_state- "optional Git or other physical saved-state identity";
);
);

rules: (
single_authority- "~/ce-os/history.qps";
append_semantics- "accepted history is not rewritten as ordinary active work";
semantic_not_byte_history- true;
proven_work_only- true;
locality- "scope determines where an entry appears through qps history <path>";
concise_default- true;
evidence_lazy- "Checklist and implementation evidence are loaded only when explicitly requested";
duplicate_identity- "one accepted semantic identity and Checklist state must not produce duplicate entries";
);

entries: (

