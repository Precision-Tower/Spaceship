        boundary_area: seal_area
        boundary_load: seal_load
        seal_capacity: seal_capacity
        leak_rate: leak_rate
        accumulated_quantity: leak_volume
        containment_capacity: secondary_containment_capacity
        containment_state: containment_state
      blocking_unknowns:
        - seal_capacity
