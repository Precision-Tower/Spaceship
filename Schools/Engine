causal_architecture_stabilization:
  objective: stable_4_file_reasoning_substrate
  files:
    - Values.yaml
    - Operators.yaml
    - Formats.yaml
    - Machine.yaml

  authority_rule:
    Values.yaml: defines_variables_states_domains_and_validation_linked_terms
    Operators.yaml: defines_reusable_causal_transforms_using_values
    Formats.yaml: composes_operators_into_engineering_templates
    Machine.yaml: governs_operational_states_using_values_operators_formats
    no_file_may_redefine_authority_owned_by_another_file: true

  inheritance_order:
    - Values
    - Operators
    - Formats
    - Machine

  source_alignment:
    validation_tags:
      - "[VERIFIED]"
      - "[ASSUMPTION]"
      - "[HYPOTHESIS]"
      - "[ESTIMATED BEHAVIOR]"
      - "[PENDING VALIDATION]"
      - "[UNRESOLVED ENGINEERING VARIABLE]"
    topology_preserved:
      - Intercept
      - Drain/Separate
      - Contain
      - Process
      - Recover/Test
      - Reset
      - Validate
    repository_boundary: "The canonical repository remains authority for subsystem mechanics; this architecture is a causal reasoning substrate, not a subsystem rewrite."

Values.yaml:
  authority: variable_identity_and_state_identity_only
  must_not_define:
    - causal_transforms
    - operator_equations
    - subsystem_workflows
    - operational_state_rules

  domains:
    core:
      - geometry
      - mass
      - material
      - flotation
      - structural
      - fluid
      - gas
      - chemical
      - electrical
      - thermal
      - environmental
      - operational
      - logistics
      - safety
      - validation

  variable_classes:
    measurable:
      geometry:
        - length
        - width
        - height
        - wall_thickness
        - object_spacing
        - mounting_height
        - seal_area
        - boundary_area
      mass:
        - dry_weight
        - wet_weight
        - payload_weight
        - biomass_weight
        - residue_mass
      flotation:
        - freeboard
        - trim_angle
        - list_angle
        - waterline_z
      fluid:
        - drainage_rate
        - flow_rate
        - leak_rate
        - retained_water_mass
      gas:
        - gas_pressure
        - gas_volume
        - gas_composition
        - gas_generation_rate
        - vent_flow_rate
      electrical:
        - voltage
        - current
        - power
        - runtime
        - duty_cycle
        - charge_rate
      environmental:
        - wave_height
        - wind_speed
        - current_speed
        - salinity
        - temperature
        - turbidity
        - pH
      operational:
        - operator_cycle_time
        - reset_cycle_time
        - deployment_time
        - retrieval_time
        - manpower_ratio
        - inspection_status
      validation:
        - batch_id
        - cycle_count
        - repeat_count
        - anomaly_count
        - measurement_precision
        - evidence_level

    derived:
      geometry:
        - internal_volume
        - external_volume
        - surface_area
        - footprint_area
        - deck_zone_area
        - submerged_volume
        - exposed_area
      mass:
        - loaded_weight
        - fluid_weight
        - total_mass
        - point_load
        - distributed_load
        - center_of_mass
      flotation:
        - displacement_volume
        - buoyant_force
        - buoyancy_margin
        - reserve_buoyancy
      structural:
        - frame_load
        - cradle_load
        - anchor_load
        - shear_load
        - bending_moment
        - strap_tension
      fluid_gas:
        - accumulated_quantity
        - leak_volume
        - headspace_volume
        - pressure_margin
      electrical:
        - required_energy
        - available_energy
        - energy_margin
      operational:
        - workforce_margin
        - reset_capacity_margin
        - ready_inventory_rate
      validation:
        - evidence_gap
        - validation_state

    unresolved_or_threshold:
      - minimum_buoyancy_margin
      - minimum_safe_freeboard
      - trim_limit
      - list_limit
      - sea_state_limit
      - venting_limit
      - containment_threshold
      - acceptable_leak_rate
      - workflow_requirement
      - safe_shutdown_requirement
      - repeatability_threshold
      - sample_size_requirement
      - operating_envelope_definition

  states:
    operational:
      - idle
      - deployment
      - interception
      - towing
      - drainage
      - separation
      - digestion
      - transfer
      - recovery_testing
      - reset
      - maintenance
      - degraded_operation
      - environmental_hold
      - containment_hold
      - shutdown
      - emergency_retrieval

    physical:
      - float_state
      - stable
      - unstable
      - overload_state
      - overflow_state
      - leak_state
      - clogged_state
      - sealed_state
      - venting_state
      - isolated_state
      - degraded_state
      - recovery_state
      - ready_state
      - service_state
      - failure_state

    validation:
      - modeled_operation
      - bounded_operation
      - experimentally_supported_operation
      - operationally_validated_operation

  validation_classifications:
    official_tags:
      - "[VERIFIED]"
      - "[ASSUMPTION]"
      - "[HYPOTHESIS]"
      - "[ESTIMATED BEHAVIOR]"
      - "[PENDING VALIDATION]"
      - "[UNRESOLVED ENGINEERING VARIABLE]"

variables:

  # GEOMETRY

  - variable_name: length
    computational_domain: geometry
    applies_to: all_physical_objects
    why_it_matters_computationally: defines occupied volume, footprint, spacing, and collision bounds
    variable_type: measurable

  - variable_name: width
    computational_domain: geometry
    applies_to: all_physical_objects
    why_it_matters_computationally: defines deck crowding, service lanes, and lateral load placement
    variable_type: measurable

  - variable_name: height
    computational_domain: geometry
    applies_to: all_physical_objects
    why_it_matters_computationally: defines vertical clearance, center-of-mass height, access, and stacking risk
    variable_type: measurable

  - variable_name: wall_thickness
    computational_domain: geometry
    applies_to: HDPE_chambers, HDPE_drums, containment_trays, hoses, storage_locker
    why_it_matters_computationally: affects internal volume, structural strength, mass, and containment behavior
    variable_type: measurable

  - variable_name: internal_volume
    computational_domain: geometry
    applies_to: digestion_chambers, electrolysis_cells, chemical_storage, hoses, containment_trays, flotation_drums
    why_it_matters_computationally: determines fill volume, displacement, payload capacity, and fluid containment limits
    variable_type: derived

  - variable_name: external_volume
    computational_domain: geometry
    applies_to: all_physical_objects
    why_it_matters_computationally: defines occupied space and collision envelope
    variable_type: derived

  - variable_name: surface_area
    computational_domain: geometry
    applies_to: deck, grating, chambers, drums, trays, lab_frame, hoses, storage_locker
    why_it_matters_computationally: affects corrosion exposure, UV exposure, heat exchange, and cleaning burden
    variable_type: derived

  - variable_name: footprint_area
    computational_domain: geometry
    applies_to: deck_zones, chambers, lab_blocks, power_blocks, storage_blocks, trays, manifolds
    why_it_matters_computationally: determines deck occupancy, crowding, and placement conflicts
    variable_type: derived

  - variable_name: clearance_envelope
    computational_domain: geometry
    applies_to: walkways, chambers, hatches, electrolysis_bays, manifolds, hose_paths, emergency_routes
    why_it_matters_computationally: defines whether operators can access, service, inspect, and escape
    variable_type: computed_later

  - variable_name: hatch_swing_envelope
    computational_domain: geometry
    applies_to: digestion_chambers, chemical_storage, battery_enclosures, lab_access_panels
    why_it_matters_computationally: determines service access and collision risk
    variable_type: computed_later

  - variable_name: deck_zone_area
    computational_domain: geometry
    applies_to: intake_zone, drain_zone, process_zone, lab_zone, power_zone, interface_zone
    why_it_matters_computationally: supports area allocation and workflow path analysis
    variable_type: derived

  - variable_name: object_spacing
    computational_domain: geometry
    applies_to: chamber_rows, flotation_rows, electrolysis_bays, storage_blocks, manifolds
    why_it_matters_computationally: affects inspection access, center-of-mass distribution, and interference risk
    variable_type: measurable

  - variable_name: mounting_height
    computational_domain: geometry
    applies_to: chambers, manifolds, electrolysis_cells, batteries, controls, hoses, drums
    why_it_matters_computationally: affects reach, center of mass, hose routing, and splash exposure
    variable_type: measurable


  # MASS

  - variable_name: dry_weight
    computational_domain: mass
    applies_to: all_physical_objects
    why_it_matters_computationally: baseline mass for load, flotation, and center-of-mass calculations
    variable_type: measurable

  - variable_name: wet_weight
    computational_domain: mass
    applies_to: biomass_zones, drainage_tiles, chambers, hoses, trays, barge_deck
    why_it_matters_computationally: determines worst-case handling load and flotation demand
    variable_type: measurable

  - variable_name: payload_weight
    computational_domain: mass
    applies_to: digestion_chambers, intake_zone, drain_zone, process_zone, boat_lab, chemical_storage
    why_it_matters_computationally: defines variable load carried by each structure
    variable_type: measurable

  - variable_name: fluid_weight
    computational_domain: mass
    applies_to: chambers, hoses, electrolysis_cells, trays, storage_locker, manifolds
    why_it_matters_computationally: affects load state, transfer forces, and center-of-mass shifts
    variable_type: derived

  - variable_name: biomass_weight
    computational_domain: mass
    applies_to: intake_zone, drain_zone, digestion_chambers
    why_it_matters_computationally: drives payload, drainage, stability, and handling calculations
    variable_type: measurable

  - variable_name: loaded_weight
    computational_domain: mass
    applies_to: chambers, trays, storage_locker, hoses, barge, boat
    why_it_matters_computationally: combines dry weight and contents for structural and flotation analysis
    variable_type: derived

  - variable_name: center_of_mass_x
    computational_domain: mass
    applies_to: all_objects, barge_system, boat_system, combined_system
    why_it_matters_computationally: determines longitudinal trim and load balance
    variable_type: derived

  - variable_name: center_of_mass_y
    computational_domain: mass
    applies_to: all_objects, barge_system, boat_system, combined_system
    why_it_matters_computationally: determines port/starboard balance and tipping risk
    variable_type: derived

  - variable_name: center_of_mass_z
    computational_domain: mass
    applies_to: all_objects, barge_system, boat_system, combined_system
    why_it_matters_computationally: determines stability sensitivity and overturning risk
    variable_type: derived

  - variable_name: load_distribution_x
    computational_domain: mass
    applies_to: barge_deck, boat_deck, chamber_rows, flotation_rows
    why_it_matters_computationally: shows front/rear loading and trim tendency
    variable_type: computed_later

  - variable_name: load_distribution_y
    computational_domain: mass
    applies_to: barge_deck, boat_deck, chamber_rows, flotation_rows
    why_it_matters_computationally: shows port/starboard balance and asymmetric loading
    variable_type: computed_later

  - variable_name: point_load
    computational_domain: mass
    applies_to: chamber_cradles, battery_block, electrolysis_skids, storage_locker, manifold_mounts
    why_it_matters_computationally: determines localized deck and frame stress
    variable_type: derived

  - variable_name: distributed_load
    computational_domain: mass
    applies_to: deck, grating, drum_rows, intake_zone, drain_zone, process_zone
    why_it_matters_computationally: determines broad structural support requirement
    variable_type: derived

  - variable_name: moving_load
    computational_domain: mass
    applies_to: operators, wet_biomass, hoses, chambers_during_service
    why_it_matters_computationally: affects transient imbalance and dynamic stability
    variable_type: computed_later


  # MATERIAL

  - variable_name: material_type
    computational_domain: material
    applies_to: all_physical_objects
    why_it_matters_computationally: determines density, strength, corrosion behavior, thermal behavior, and compatibility
    variable_type: assumed

  - variable_name: density
    computational_domain: material
    applies_to: all_physical_objects
    why_it_matters_computationally: converts geometry into estimated mass
    variable_type: assumed

  - variable_name: tensile_strength
    computational_domain: material
    applies_to: straps, frames, cradles, hoses, fasteners, grating
    why_it_matters_computationally: constrains allowable tension and structural stress
    variable_type: measurable

  - variable_name: compressive_strength
    computational_domain: material
    applies_to: deck, cradles, drum_supports, chamber_supports, storage_mounts
    why_it_matters_computationally: constrains crushing, deck loading, and support compression
    variable_type: measurable

  - variable_name: flexural_strength
    computational_domain: material
    applies_to: deck, grating, frame_members, HDPE_chambers, HDPE_drums
    why_it_matters_computationally: determines bending resistance under load
    variable_type: measurable

  - variable_name: modulus_of_elasticity
    computational_domain: material
    applies_to: deck_frame, grating, chamber_cradles, flotation_supports
    why_it_matters_computationally: supports deflection and flex calculations
    variable_type: measurable

  - variable_name: corrosion_resistance
    computational_domain: material
    applies_to: aluminum, steel, stainless, fasteners, manifolds, electrical_housings
    why_it_matters_computationally: affects lifecycle, inspection interval, and failure risk
    variable_type: measurable

  - variable_name: UV_resistance
    computational_domain: material
    applies_to: HDPE_drums, HDPE_chambers, hoses, plastic_trays, marker_panels
    why_it_matters_computationally: affects degradation in Belize sun exposure
    variable_type: measurable

  - variable_name: chemical_compatibility
    computational_domain: material
    applies_to: hoses, trays, electrolysis_cells, chambers, seals, storage_locker, manifolds
    why_it_matters_computationally: determines whether materials tolerate process fluids and byproducts
    variable_type: measurable

  - variable_name: abrasion_resistance
    computational_domain: material
    applies_to: grating, hoses, chamber_ports, tile_panels, intake_interface
    why_it_matters_computationally: affects wear from sand, sargassum fibers, and handling
    variable_type: measurable

  - variable_name: seal_material
    computational_domain: material
    applies_to: chamber_hatches, quick_connects, manifolds, hoses, electrolysis_cells
    why_it_matters_computationally: determines containment reliability and replacement cycle
    variable_type: assumed

  - variable_name: fastener_material
    computational_domain: material
    applies_to: frames, cradles, straps, manifolds, deck_panels, lab_skids
    why_it_matters_computationally: affects galvanic corrosion and structural security
    variable_type: assumed

  - variable_name: galvanic_pairing_risk
    computational_domain: material
    applies_to: aluminum_frame, stainless_fasteners, steel_generator, manifolds, cradles
    why_it_matters_computationally: identifies corrosion acceleration from material pairings
    variable_type: computed_later


  # FLOTATION

  - variable_name: displacement_volume
    computational_domain: flotation
    applies_to: HDPE_drum_rows, barge_total, boat_total
    why_it_matters_computationally: determines buoyant force potential
    variable_type: derived

  - variable_name: submerged_volume
    computational_domain: flotation
    applies_to: drum_rows, barge, boat
    why_it_matters_computationally: determines actual buoyancy at a given load condition
    variable_type: computed_later

  - variable_name: buoyant_force
    computational_domain: flotation
    applies_to: drum_rows, barge, boat
    why_it_matters_computationally: compares flotation support to total system weight
    variable_type: derived

  - variable_name: buoyancy_margin
    computational_domain: flotation
    applies_to: barge, drum_rows, boat
    why_it_matters_computationally: measures remaining flotation capacity after loading
    variable_type: computed_later

  - variable_name: freeboard
    computational_domain: flotation
    applies_to: barge, boat
    why_it_matters_computationally: tracks deck height above water under load
    variable_type: measurable

  - variable_name: trim_angle
    computational_domain: flotation
    applies_to: barge, boat
    why_it_matters_computationally: describes front/rear tilt under load
    variable_type: measurable

  - variable_name: list_angle
    computational_domain: flotation
    applies_to: barge, boat
    why_it_matters_computationally: describes port/starboard tilt under asymmetric load
    variable_type: measurable

  - variable_name: metacentric_height
    computational_domain: flotation
    applies_to: barge, boat
    why_it_matters_computationally: supports stability analysis
    variable_type: computed_later

  - variable_name: reserve_buoyancy
    computational_domain: flotation
    applies_to: barge, boat, drum_rows
    why_it_matters_computationally: defines additional buoyancy before unsafe immersion
    variable_type: computed_later

  - variable_name: flotation_failure_tolerance
    computational_domain: flotation
    applies_to: drum_rows, barge
    why_it_matters_computationally: determines effect of losing one or more flotation units
    variable_type: computed_later

  - variable_name: waterline_z
    computational_domain: flotation
    applies_to: barge, boat, drum_rows
    why_it_matters_computationally: defines immersion state and exposure boundaries
    variable_type: measurable


  # STRUCTURAL

  - variable_name: frame_load
    computational_domain: structural
    applies_to: barge_deck, scaffolding_frame, boat_deck, lab_frame
    why_it_matters_computationally: determines total load carried by structural frame
    variable_type: derived

  - variable_name: deck_load_limit
    computational_domain: structural
    applies_to: barge_deck, boat_deck
    why_it_matters_computationally: constrains maximum safe mass placement
    variable_type: measurable

  - variable_name: cradle_load
    computational_domain: structural
    applies_to: chamber_cradles
    why_it_matters_computationally: determines whether chamber supports carry static and dynamic loads
    variable_type: derived

  - variable_name: strap_tension
    computational_domain: structural
    applies_to: tie_down_bands, chamber_straps, drum_straps, hose_strain_relief
    why_it_matters_computationally: determines restraint loading under motion
    variable_type: computed_later

  - variable_name: anchor_load
    computational_domain: structural
    applies_to: tie_down_points, manifold_mounts, strain_relief_points, tow_points
    why_it_matters_computationally: identifies localized hardware stress
    variable_type: derived

  - variable_name: bending_moment
    computational_domain: structural
    applies_to: frame_members, deck_spans, grating_panels, cradles
    why_it_matters_computationally: supports bending and failure analysis
    variable_type: computed_later

  - variable_name: shear_load
    computational_domain: structural
    applies_to: deck_panels, frame_joints, fasteners, manifold_mounts, tie_downs
    why_it_matters_computationally: constrains connection strength
    variable_type: computed_later

  - variable_name: deflection
    computational_domain: structural
    applies_to: deck, grating, frame_members, chamber_cradles
    why_it_matters_computationally: determines sag, misalignment, and serviceability
    variable_type: measurable

  - variable_name: fatigue_cycles
    computational_domain: structural
    applies_to: straps, cradles, fasteners, hose_connections, drum_supports, grating
    why_it_matters_computationally: tracks repeated loading and wear accumulation
    variable_type: measurable

  - variable_name: impact_load
    computational_domain: structural
    applies_to: intake_interface, chambers, drum_rows, boat_barge_interface
    why_it_matters_computationally: captures collision, wave slap, and handling shocks
    variable_type: computed_later

  - variable_name: vibration_load
    computational_domain: structural
    applies_to: boat_power_zone, PMA_generator, electrolysis_bays, manifolds
    why_it_matters_computationally: affects mounting, fatigue, and connection reliability
    variable_type: measurable


  # FLUID

  - variable_name: fill_percent
    computational_domain: fluid
    applies_to: chambers, electrolysis_cells, chemical_storage, trays, hoses
    why_it_matters_computationally: determines fluid mass, headspace, and containment margin
    variable_type: measurable

  - variable_name: fluid_volume
    computational_domain: fluid
    applies_to: chambers, hoses, trays, electrolysis_cells, storage_locker, manifolds
    why_it_matters_computationally: determines mass, transfer demand, and containment capacity
    variable_type: measurable

  - variable_name: drainage_rate
    computational_domain: fluid
    applies_to: grated_tile_panels, drain_zone, intake_zone
    why_it_matters_computationally: determines how quickly wet biomass mass changes
    variable_type: measurable

  - variable_name: flow_rate
    computational_domain: fluid
    applies_to: hoses, manifolds, chamber_ports, electrolysis_inputs, storage_outputs
    why_it_matters_computationally: supports transfer timing and pressure calculations
    variable_type: measurable

  - variable_name: pressure
    computational_domain: fluid
    applies_to: chambers, hoses, manifolds, electrolysis_cells, storage_vessels
    why_it_matters_computationally: determines containment load and leak risk
    variable_type: measurable

  - variable_name: head_pressure
    computational_domain: fluid
    applies_to: chambers, storage, hoses, electrolysis_cells
    why_it_matters_computationally: depends on vertical fluid column and affects fittings
    variable_type: derived

  - variable_name: leak_rate
    computational_domain: fluid
    applies_to: chamber_hatches, hoses, quick_connects, trays, manifolds
    why_it_matters_computationally: quantifies containment failure
    variable_type: measurable

  - variable_name: tray_capacity
    computational_domain: fluid
    applies_to: drip_trays, electrolysis_trays, lab_containment
    why_it_matters_computationally: determines spill capture limit
    variable_type: measurable

  - variable_name: residual_fluid_volume
    computational_domain: fluid
    applies_to: hoses, chambers, trays, manifolds
    why_it_matters_computationally: affects cleaning, contamination, and reset state
    variable_type: measurable

  - variable_name: viscosity
    computational_domain: fluid
    applies_to: process_fluids, slurry, hose_transfer
    why_it_matters_computationally: affects pumpability, flow rate, and pressure loss
    variable_type: measurable

  - variable_name: sediment_fraction
    computational_domain: fluid
    applies_to: chamber_contents, drain_zone, hoses, manifolds
    why_it_matters_computationally: affects clogging, abrasion, and flow resistance
    variable_type: measurable


  # GAS

  - variable_name: gas_volume
    computational_domain: gas
    applies_to: chamber_headspace, hoses, manifolds, electrolysis_cells, vent_path
    why_it_matters_computationally: defines containment and transfer quantity
    variable_type: measurable

  - variable_name: headspace_volume
    computational_domain: gas
    applies_to: digestion_chambers, electrolysis_cells, storage_vessels
    why_it_matters_computationally: affects pressure, gas accumulation, and safety margin
    variable_type: derived

  - variable_name: gas_pressure
    computational_domain: gas
    applies_to: chambers, gas_hoses, manifolds, vent_path
    why_it_matters_computationally: determines containment force and leak risk
    variable_type: measurable

  - variable_name: gas_flow_rate
    computational_domain: gas
    applies_to: gas_hoses, manifolds, chamber_ports, vent_path
    why_it_matters_computationally: supports transfer and venting calculations
    variable_type: measurable

  - variable_name: gas_composition
    computational_domain: gas
    applies_to: chamber_headspace, electrolysis_outputs, gas_hose_path, vent_path
    why_it_matters_computationally: determines hazard classification and routing requirements
    variable_type: measurable

  - variable_name: vent_rate
    computational_domain: gas
    applies_to: lab_vent_path, gas_routing, electrolysis_bays
    why_it_matters_computationally: determines gas accumulation risk
    variable_type: measurable

  - variable_name: gas_accumulation_zone_volume
    computational_domain: gas
    applies_to: lab_zone, chamber_area, manifold_area, boat_deck
    why_it_matters_computationally: identifies spaces where gases could collect
    variable_type: derived


  # ELECTRICAL

  - variable_name: voltage
    computational_domain: electrical
    applies_to: battery_bank, electrolysis_cells, monitoring_panel, PMA_generator, solar_input
    why_it_matters_computationally: supports electrical sizing and safety calculations
    variable_type: measurable

  - variable_name: amperage
    computational_domain: electrical
    applies_to: battery_bank, electrolysis_cells, PMA_generator, solar_input, wiring
    why_it_matters_computationally: determines conductor sizing, heat, and power delivery
    variable_type: measurable

  - variable_name: power_draw
    computational_domain: electrical
    applies_to: electrolysis_A, electrolysis_B, monitoring_panel, pumps, ventilation, controls
    why_it_matters_computationally: determines energy demand and load hierarchy
    variable_type: measurable

  - variable_name: battery_capacity
    computational_domain: electrical
    applies_to: battery_block
    why_it_matters_computationally: determines stored electrical energy available
    variable_type: measurable

  - variable_name: state_of_charge
    computational_domain: electrical
    applies_to: battery_block
    why_it_matters_computationally: determines current usable energy
    variable_type: measurable

  - variable_name: charge_rate
    computational_domain: electrical
    applies_to: solar_input, PMA_generator, battery_block
    why_it_matters_computationally: determines replenishment rate
    variable_type: measurable

  - variable_name: discharge_rate
    computational_domain: electrical
