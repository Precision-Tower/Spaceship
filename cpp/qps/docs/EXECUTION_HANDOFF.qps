root_qps_query- "proven"/a;
active_corpus_count- 44;
active_corpus_passed- 44;
active_surface_items- 132;
active_surface_failed- 0;
);

execution_frontier: (
step_1- "testSuite integration implemented and proven"/a;
step_2- "qps test path/file.qps implemented and proven"/a;
step_3- "qps test path/folder implemented and proven"/a;
step_4- "quiet one-line PASS reporting implemented and proven"/a;
step_5- "failure path:ln plus reason implemented and proven"/a;
step_6- "focused file and folder CLI regression implemented and passing"/a;
step_7- "full QPS CTest and active Engineering corpus regression passing"/a;
step_8- "execution and testSuite checkpoint ready for commit"/a;
);

do_not_do: (
reset_dirty_work- false/b;
rewrite_hev- false/b;
rewrite_engineering_items- false/b;
scan_entire_repository- false/b;
mix_causal_bang_into_execution- false/b;
);

operational_root- "~/ce-os/_index.qps"/a;
