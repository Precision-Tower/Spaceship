qps.
QPS: def"Quick Parse Standard";
purpose: def"QPS is the structural engineering language used by CE-OS to describe semantic structure, authored values, references, execution, and Engineering operations.";
authority: def"This quicksheet describes current measured QPS. Current parser behavior, passing tests, and active QPS corpus take precedence over stale documentation.";

identity: (
name- "Quick Parse Standard";
extension- ".qps";
runtime- "qps/cpp";
corpus- "Engineering/qps";
);

closure.
rule: def"Every QPS construct owns its own termination. Closing a child does not implicitly close its parent.";
separator: def"A separator is used only where peer boundaries are otherwise ambiguous.";

primitives.
Key: def"A Key is written identifier. and establishes a structural surface.";
Term: def"A Term is written identifier: content; and owns its terminating semicolon.";
Item: def"An Item is written identifier- value; and owns its terminating semicolon.";
Container: def"A Container is written (...) and owns its closing parenthesis.";
Dictionary: def"A Dictionary is written [...] and owns its closing bracket. The Dictionary declaration is terminated with semicolon.";
Reference: def"A structural reference is written inside brackets and navigates QPS structure.";
Execution: def"An execution definition is written {...} and owns its closing brace.";

key_example.
description: def"A Key may contain Terms and other structural declarations. Surface Keys terminate at paragraph boundary or end of file.";
name- "example";

items.
empty-;
numeric- 10;
decimal- .5;
text- "steel";
flag- true;
nothing- null;
distance- 5/in;
depth- 1/ft;

containers.
single: (
value- 1;
);
multiple: (
a- 1;
b- 2;
c- 3;
);
nested: (
master: (
radius- 5/in;
depth- 1/in;
);
slave: (
radius- 2/in;
depth- 1/in;
);
);

nested_term_ownership.
system:
master: (
radius- 5/in;
);
slave: (
radius- 2/in;
);
;

dense_structure.
pu_master: dimensions:
(body: radius- 5/in; depth- 1/in;;)
(groove: x_center- .5/in;;);;

references.
external: def"[>name] begins structural navigation from the current QPS document.";
external_path: def"[>shape.dimensions] navigates authored structure.";
local: def"[name.member] navigates from an execution-local structural binding.";
item_value: def"A trailing - inside a structural reference explicitly selects an Item value.";
module_navigation: def"Leading dot and slash forms alter file or module navigation according to the structural resolver.";

reference_source.
dimensions: (
body: (
radius- 5/in;
depth- 1/in;
);
groove: (
x_center- .5/in;
);
);

{reference_model:
master: [>reference_source.dimensions];
body: [master.body];
groove: [master.groove];
}

dictionaries.
rule: def"Dictionary entries may use commas where values do not provide their own structural boundary.";

bare_values: [
1: "master",
2: "slave"
];;

structural_values: [
1: radius- 5/in;
2: depth- 1/in;
];;

units.
rule: def"QPS preserves authored unit suffixes. Engineering owns the physical interpretation of units.";
examples: (
radius- 5/in;
length- 3/ft;
pressure- 120/psi;
);

functions.
rule: def"Function declaration parameters are Items inside a Container. Their semicolons provide their boundaries. Function call arguments use commas because expression arguments do not self-terminate.";

-func leverage(
f-/n;
arm-/n;
){
%T: f * arm
-return T;
}

function_call.
{run:
%answer: leverage(10, 3)
}

execution.
definition: def"A named braced construct creates an execution definition.";
workspace: def"A Term containing a structural reference creates a local structural binding in an execution workspace.";
boundary: def"Execution state does not redefine authored structural state.";

geometry.
qualification: def"The at marker qualifies a Term as GEOMETRY work.";
structural_input: def"Geometry actions may consume execution-local structural bindings.";
actions: def"Multiple geometry actions use commas because action invocations do not self-terminate individually. The Term semicolon closes the geometry stage.";
parameters: def"Bare action parameter names use commas when multiple names are supplied. Item overrides own their own semicolons.";

geometry_source.
Shape: (
radius- 5/in;
depth- 1/in;
);

{geometry_example:
master: [>geometry_source.Shape];
@solid: -cylinder(master), -wrap(master);
}

runtime.
values: (
numeric- "NUMERIC";
structure- "STRUCTURE";
geometry- "GEOMETRY";
);
rule: def"Numeric state, resolved structure, and geometry are distinct runtime value kinds.";
conversion: def"Geometry does not silently become numeric.";

bindings.
supplied: def"SUPPLIED identifies runtime state provided to execution.";
derived: def"DERIVED identifies semantic state produced through execution.";
local: def"LOCAL identifies execution-workspace state.";

modules.
index- "<index.qps";
rule: def"A QPS directory may act as a module.";
index_rule: def"<index.qps is the canonical module surface document for a QPS directory.";
legacy_index: def"<index.qps is a legacy module-surface filename still present in older QPS workspaces pending migration.";
surface: def"<index.qps exposes symbols from documents within that module.";
documents: def"Runtime QPS documents use the .qps extension.";

punctuation.
semicolon: def"Semicolon terminates Items, Terms, and declaration forms that require explicit termination.";
comma: def"Comma separates peers only when their boundaries are otherwise ambiguous, including function-call arguments, geometry action peers, bare geometry parameters, and bare Dictionary values.";
backslash: def"Backslash has no canonical structural collection role.";
list_closer: def"The historical dedicated collection closer is not canonical QPS.";

domains.
generic: def"Named braced execution definitions provide a shared execution workspace.";
calculation: def"The percent marker identifies calculation behavior and is working.";
geometry_domain: def"The at marker identifies geometry-qualified behavior and is working, with geometry functionality still under active development.";
model: def"The dollar marker is lexed as MODEL_MARKER, but canonical execution semantics are not implemented yet.";
causal: def"The exclamation domain belongs to the intended QPS model, but canonical implementation semantics are not established yet.";

engineering_boundary.
QPS_owns: (
syntax- "language grammar";
structure- "authored structural representation";
references- "structural navigation";
execution- "execution semantics";
bindings- "runtime binding semantics";
);
Engineering_owns: (
units- "physical interpretation of authored units";
geometry_structure- "interpretation of Engineering geometry structure";
native_geometry- "native geometry construction";
backend- "OCCT and other Engineering backends";
);

status.
structural_language- "working";
keys_terms_items- "working";
containers- "working";
dictionaries- "working";
structural_references- "working";
modules- "working";
execution_definitions- "working";
execution_structural_bindings- "working";
calculation_percent- "working";
geometry_at- "working_active_development";
native_mesh- "observed_working";
model_dollar- "lexed_not_implemented";
causal_bang- "not_canonically_implemented";
godot_geometry_capture- "next_integration_edge";

reconstruction.
evidence:
implementation- "current source";
tests- "current passing tests";
corpus- "current active QPS";
documentation- "supporting or historical evidence";
;
rule: def"Implementation, passing tests, and active corpus define the current QPS reconstruction baseline.";
legacy: def"Historical syntax may remain in archives without remaining part of canonical QPS.";
unknowns: def"Unresolved syntax remains explicit until measured against implementation and tests.";


modules.
surface- "<index.qps";
surface_role- "canonical QPS module surface for a directory";
ownership- "the directory owns its <index.qps surface";
implementation- "a module surface describes or exposes the subsystem; it does not replace implementation code";
navigation- "module and file navigation is resolved by the QPS runtime";

module_example.
directory- "UI/OperatorShell";
surface- "UI/OperatorShell/<index.qps";
implementation- "Godot GDScript";
relationship- "<index.qps webs into the existing OperatorShell directory tree";

brackets.
dictionary- "[]";
structural_reference- "[>...]";
local_reference- "[name...]";
rule- "Bracket meaning is determined by the construct opened inside the brackets";

dictionary_example.
settings: [
1: "compact",
2: "comfortable",
3: "dense"
];;

references.
structural- "[>name]";
structural_role- "begin resolution from QPS structural scope";
local- "[name.member]";
local_role- "begin navigation from an already-bound local structural root";
dot- ".";
dot_role- "descend through semantic or structural members";
slash- "/";
slash_role- "navigate module or file structure";
parent- "/";
parent_role- "leading slash traversal moves through parent module scope";
item_value- "-";
item_value_role- "a trailing hyphen selects an Item value rather than only its structural Item";

reference_examples.
current_structure- "[>shape.dimensions]";
local_structure- "[master.groove]";
item_value- "[>shape.dimensions.cylinder.radius-]";

reference_rule.
resolution- "QPS references preserve authored navigation; semantic resolution determines the referenced structure or value";
structure- "a reference without trailing '-' may select structure";
value- "a reference ending in '-' explicitly selects an Item value";

execution_binding_example.
source- "{build: master: [>shape.Shape]; @solid: -cylinder(master), -wrap(master); }";
master- "[>shape.Shape]";
local_use- "master";
geometry_actions- "-cylinder(master), -wrap(master)";
rule- "an external structural reference may be bound locally and reused inside execution";

qps_cli.
inspect- "qps <document.qps>";
check- "qps <document.qps> --check";
get- "qps <document.qps> --get <path>";

qps_cli_behavior.
inspect- "parse and print the AST for human inspection";
check- "parse silently; success is exit code 0 and no output";
get- "parse and return one scalar Item value addressed by path";
automation_rule- "automated agents should prefer --check and --get and should not print the AST unless debugging a parser problem";

query_examples.
terminal_density- "qps/cpp/build/qps 'UI/OperatorShell/<index.qps' --get terminal.density";
layout_left_panel- "qps/cpp/build/qps 'UI/OperatorShell/<index.qps' --get layout.left_panel";
quiet_check- "qps/cpp/build/qps 'UI/OperatorShell/<index.qps' --check";

codex_interface.
language_reference- "qps/docs/QPS.qps";
canonical_module_surface- "<index.qps";
validation- "--check";
scalar_query- "--get";
rule- "read this quicksheet before authoring unfamiliar QPS";
rule2- "do not invent QPS syntax";
rule3- "do not use AST output as routine validation";
rule4- "successful validation should remain quiet";


document_model.
file- "A .qps document is a structural namespace and may contain multiple independent Keys Terms Items and executable surfaces.";
role- "The physical file is only one layer of QPS structure; semantic structure continues inside the file.";

key_model.
key- "A Key creates a named structural surface inside a QPS document.";
analogy- "A Key may be treated like a semantic file inside the physical file.";
role- "Keys organize related Terms Items definitions nested structures and executable surfaces without requiring another filesystem document.";

term_model.
term- "A Term is a named collection or semantic grouping.";
relationship- "Terms commonly live inside Keys but are not inherently dependent on Keys.";
role- "Terms group related structure beneath a name.";

item_model.
item- "An Item is a value-bearing declaration or unresolved value slot.";
role- "Items are leaves that may carry literal values type hints units or references.";

module_surface_model.
index- "<index.qps";
rule- "<index.qps is the active QPS surface of its directory, not an empty package marker.";
content- "<index.qps may contain real configuration Keys Terms Items relationships exports and references.";
extension- "Additional .qps files may deepen the module while <index.qps remains the canonical entry surface.";

web_model.
rule- "QPS modules and semantic structures form a navigable web.";
filesystem- "'/' moves through module or file structure.";
semantic- "'.' moves through Keys Terms and nested semantic structure.";
reference- "[>] begins structural resolution from QPS scope.";
local- "[name.member] descends from a local structural binding.";
value- "A trailing '-' explicitly selects an Item value.";

structure_example.
OperatorShell: (
terminal: (
density- "compact";
first- true;
);
layout: (
left_panel- true;
right_rail- false;
);
);

structure_example_explanation.
OperatorShell- "Key";
terminal- "Term inside OperatorShell";
density- "Item inside terminal";
layout- "Term inside OperatorShell";
left_panel- "Item inside layout";
semantic_path- "OperatorShell.terminal.density";

index_example.
surface- "UI/OperatorShell/<index.qps";
rule- "The module surface may directly contain live configuration and relationships while pointing into the existing implementation tree.";

reference_model.
current_structure- "[>shape.dimensions]";
current_role- "resolve structure beginning from the current QPS scope";
local_structure- "[master.groove]";
local_role- "resolve from an already-bound local structural root";
item_value- "[>shape.dimensions.cylinder.radius-]";
item_role- "resolve the Item value explicitly";
module_navigation- "slash segments navigate module or file structure while dot segments descend semantic structure";
