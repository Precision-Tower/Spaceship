#include "../h/term.hpp"      // Include the term parsing header
#include "../h/_index.hpp"    // Include the main Parser header for access to its members
#include "../../ast/ast_utils.hpp" // For AST node creation helpers

namespace qps {
namespace parser {

// Note: In the final integrated parser, this function will remain a member of the Parser class.
// It is defined here to represent the content of 'term.cpp'.

// Parses a Term declaration: 'identifier: <content>;'
std::unique_ptr<ast::TermDeclarationNode> Parser::parseTermDeclaration() {
    int line = current_token_.line;
    int column = current_token_.column;

    std::string identifier =
        match_and_get_lexeme(tokens::TokenType::IDENTIFIER);
    match(tokens::TokenType::COLON); // Structural Term suffix ':'

    auto term_node = ast::createTermDeclarationNode(identifier, line, column);

    // Term content can be complex: def" statement", Item-, other Terms, Containers, Dictionaries, Causal Relations.
    // Continue parsing elements until the end of the term block (semicolon),
    // or a closing parenthesis/bracket indicating it's nested within another structure.
    while (peek_type() != tokens::TokenType::SEMICOLON && peek_type() != tokens::TokenType::END_OF_FILE &&
           peek_type() != tokens::TokenType::CLOSE_PAREN && peek_type() != tokens::TokenType::CLOSE_BRACKET) {

        if (peek_type() == tokens::TokenType::KW_DEF) {
            // A term can have a single definition string, then it ends.
            match(tokens::TokenType::KW_DEF); // Consume 'def"'
            term_node->content_.push_back(ast::createStringLiteralNode(
                match_and_get_literal<std::string>(tokens::TokenType::DEFINITION_TEXT), line, column));
            // After consuming the definition string, the term block implicitly ends.
            // The semicolon will be matched after the loop.
            break;
        } else if (peek_type() == tokens::TokenType::IDENTIFIER) {
            const auto next = peek_next_type();

            // Nested structural primitives use the same grammar everywhere:
            // name. -> Key
            // name: -> Term
            // name- -> Item
            if (next == tokens::TokenType::DOT ||
                next == tokens::TokenType::COLON ||
                next == tokens::TokenType::OP_SUBTRACT) {
                term_node->content_.push_back(parseDeclaration());
            } else {
                // A bare identifier here is data/reference content rather than
                // the beginning of a structural declaration.
                term_node->content_.push_back(parsePrimaryExpression());
            }
        } else if (peek_type() == tokens::TokenType::OPEN_PAREN) {
            // Parse a nested Container ()
            term_node->content_.push_back(parseContainer()); // Assuming parseContainer exists
        } else if (peek_type() == tokens::TokenType::OPEN_BRACKET) {
            // Parse a nested Dictionary []
            term_node->content_.push_back(parseDictionaryDeclaration()); // Assuming parseDictionaryDeclaration exists
        } else if (peek_type() == tokens::TokenType::EQUALS) {
            // This is likely a Causal Relationship. We need a parseCausalRelationship()
            // For now, error or skip.
            // TODO: Implement parseCausalRelationship();
            error("Causal relationship parsing not yet implemented for Term content: " + current_token_.toString());
        }
        // Handle commas separating elements in a list within the term.
        if (peek_type() == tokens::TokenType::COMMA) {
            match(tokens::TokenType::COMMA); // Consume ','
        } else if (peek_type() != tokens::TokenType::SEMICOLON &&
                   peek_type() != tokens::TokenType::CLOSE_PAREN &&
                   peek_type() != tokens::TokenType::CLOSE_BRACKET &&
                   peek_type() != tokens::TokenType::END_OF_FILE) {
            // If not a comma, and not an expected terminator, then it's an error.
            error("Expected comma or end of Term content (semicolon/closing delimiter): " + current_token_.toString());
        }
    }
    match(tokens::TokenType::SEMICOLON); // Consume ';' that terminates the term block
    return term_node;
}

} // namespace parser
} // namespace qps
