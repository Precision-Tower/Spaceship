CPP.

purpose: def"
Canonical semantic doorway into CE-OS native C++ source.
";

surface: (
qps- "cpp/qps";
);

doors: (
qps- "cpp/qps/_index.qps";
);

rules: (
local_context_first- "read this index when entering cpp";
descend_only_as_needed- "read cpp/qps/_index.qps before working deeper in QPS";
do_not_duplicate- "QPS implementation details belong under cpp/qps";
);

operations: (
enter_qps- "read cpp/qps/_index.qps";
);
