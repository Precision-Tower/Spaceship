# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*_env/

# C / C++ / CMake
**/build/
**/build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json

# Godot
.godot/
.export/
export.cfg

# Android / Gradle / Kotlin
.gradle/
**/app/build/
**/.kotlin/
local.properties
*.apk
*.aab

# Runtime state — generated by the running CE-OS node
/logs/
/run/
/state/

# Local USB/bootstrap media
/usb/
*.img

# Secrets / credentials
/config/private/
**/private/
*.key
*.pem
*.token

# Models / large runtime assets
*.gguf
*.ggml

# Editors / OS debris
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Migration / recovery working material
/ce-os-migrate/
/pre-phase2-backup/

# Agency datasets — local/training data, not source history
/Agency/Datasets/raw/

# Agent runtime memory / process state
/Agency/Agents/*/memory/Chroma/
/Agency/Agents/*/memory/short_term.yaml
*.pid

# Backup/editor leftovers
*.bak

# Agent runtime logs / sessions
/Agency/Agents/*/runtime/logs/
/Agency/Agents/*/runtime/sessions/

# CE-OS automated UI observation
/state/ui-observation/

# OperatorShell Android generated build output
/UI/OperatorShell/android/build/

# Pixel-local Android SDK/toolchain
/Android/SDK/

# Godot platform/export toolchain binaries
/Android/Godot/

# Extracted Godot Android vendor template
/UI/OperatorShell/android/template/

# qps/bin locally imported or built native toolchain sources/artifacts
/qps/bin/build/
/qps/bin/src/
