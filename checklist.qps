CHECKLIST.

purpose: def"
Canonical CE-OS Checklist workflow and example.

Checklist documents are persistent working memory for humans and agents.
Information required to understand, resume, supervise, or complete work belongs
in the repository Checklist rather than depending on conversational memory.
";

workflow: (
discover- "Run qps checklist to regenerate the repository Checklist index";
inspect- "Run qps checklist <checklist-index> <task-number> to read the entire authored task";
work- "Maintain the selected task as implementation reality changes";
complete- "Mark a task complete only after its authored done_when conditions are proven";
save- "Complete work remains visible until qps save accepts it";
history- "Saved work leaves the active Checklist view and remains recoverable through qps history";
);

task_contract: (
required- "Every task_N owns identity-, summary-, and state-";
memory- "A task may contain any authored structure useful for understanding and resuming the work";
recommended- "Nontrivial work should normally record product, current, steps, findings, decisions, proof, next, and done_when";
rendering- "qps checklist <checklist-index> <task-number> renders the complete authored task rather than a fixed selection of fields";
);

discovery_rules: (
current_task- "If newly discovered work is required to complete the current objective, record it inside the current task as a step, finding, dependency, decision, or other appropriate working memory";
deferred_work- "If newly discovered work should be done later, create a new task in the Checklist belonging to the implementation area that owns that work";
location- "Place deferred work according to where the implementation belongs, not according to which task happened to discover it";
memory- "Do not rely on chat history for a fact, decision, dependency, or next action required to resume repository work";
documentation- "For nontrivial work, explicitly record whether durable subsystem documentation changes; when required, name the applicable _index.qps authority and complete that update before marking the task complete";
);

states: (
ready- "Prepared to begin";
active- "Currently being implemented";
waiting- "Known work intentionally waiting";
blocked- "Cannot proceed until an authored dependency or condition is satisfied";
complete- "Implementation and proof are finished but the accomplishment has not yet been accepted by qps save";
saved- "qps save accepted the accomplishment into History";
);

example_task: (
identity- "example.capability";
summary- "Example shape for a nontrivial Checklist task";
state- "saved";

product- "Describe what the user or system will have when this task is finished";

current- "Describe the presently proven implementation state";

documentation: (
required- true;
authority- "path/to/_index.qps";
goal- "Describe durable subsystem truth that must be updated before this task can become complete";
state- "waiting";
);

steps: (
step_1: (
goal- "Describe one meaningful implementation step";
product- "Describe what becomes true or usable after this step";
state- "saved";
);
);

findings: (
finding_1- "Record durable facts discovered while implementing the task";
);

decisions: (
decision_1- "Record decisions another agent must preserve when resuming the work";
);

proof: (
witness_1- "Record the observable evidence supporting completion";
);

next- "State the exact next implementation move or experiment";

done_when: (
condition_1- "State a concrete observable completion condition";
);
);

current_work: (
tasks: (

task_1: (
identity- "root.repository_authority_artifacts";
summary- "Validate and reconcile the new root CE-OS authority documents and classify previously observed unexplained root artifacts without destructive assumptions";
state- "complete";

current: (
item_1- "_index.qps now documents Checklist, Save, History, structural navigation, QPS syntax, continuation authority, and goals.qps as directional rather than implementation evidence";
item_2- "goals.qps defines intended CE-OS architecture, conversion, kernel discovery, HostPlatform, provisioning, compute, and QPS-owned userspace direction";
item_3- "docs/CAUSAL_ENGINEERING_PRINCIPLE.md records the whitebox causal Engineering principle and HEV modeling intent";
item_4- "history.qps is the repository-root semantic history ledger and already contains accepted QPS and Cipher accomplishments";
item_5- "Eight untracked zero-byte root files were previously observed at the repository root: 0, =, IdentifierNode, SymbolReferenceNode, TYPE_NUMERIC, none, v-], and void; they are not present in the current root inventory";
item_6- "The observed names resemble command or parser tokens, but appearance alone does not establish origin, ownership, or disposability";
);

documentation: (
required- true;
authority- "_index.qps";
goal- "Keep root durable authority consistent with goals.qps, Checklist/Save/History lifecycle, and current QPS navigation semantics";
state- "complete";
);

steps: (
step_1: (
goal- "Validate root QPS authority documents with the current QPS checker";
state- "complete";
);
step_2: (
goal- "Determine the provenance and ownership of the eight historically observed zero-byte root files; preserve unknown entries and permit deletion only with positive evidence of disposability or explicit authority";
state- "complete";
resolution- "Bounded investigation is complete under the Operator-accepted evidence limit; unresolved lifecycle facts remain explicitly unproven";
);
step_3: (
goal- "Verify root documentation and checklist index after reconciliation";
state- "complete";
);
);

findings: (
observation- "Commit ea8632e68c57883c495a0558eb287958ecf039a8, dated 2026-09-07 16:14:54 -05:00, records all eight filenames as untracked zero-byte entries; the commit records an observation, not their creation or creator";
current_inventory- "Read-only exact-path inspection at HEAD 20e1512d8228be4a79215791d8137111c2f726eb found all eight absent, including dangling-symlink checks";
git_evidence- "git log --all on the eight literal root paths returned no tracked path history; this cannot establish the lifecycle of untracked files";
recovery_evidence- "Bounded inventories of trash/recovered and trash/retired found no exact filename matches among 29 and 1 entries respectively";
historical_inventory- "trash/tmp/root-entry-baseline.txt lists 23 root entries without the eight names and has mtime 2026-09-07 17:03:58 -05:00; its producer is unverified, so this is a retained inventory witness rather than proof of a deletion time";
cleanup_evidence- "trash/tmp/post-cleanup-strays.txt is empty with mtime 2026-09-07 17:28:10 -05:00; without its producing command, emptiness proves neither what was checked nor what was removed";
token_evidence- "qps/cpp/src/ast/ast_node.hpp:33-34 declares SymbolReferenceNode and IdentifierNode; qps/cpp/src/tokens/h/token.hpp:20 declares TYPE_NUMERIC. Source-token ownership does not establish ownership of same-named root files";
search_boundary- "Root authority and historical notes, selected recovered text, immediate trash/tmp text, and a bounded pattern search of logs/privileged-audit.log supplied no creator or removal command; these searches do not prove absence of references elsewhere";
unresolved- "The creator, creation workflow, filesystem ownership at creation, runtime purpose, and disappearance mechanism remain unproven for all eight entries";
);

proof: (
root_validation- "qps check passed for _index.qps, goals.qps, checklist.qps, and history.qps before reconciliation";
checklist_navigation- "qps checklist and qps checklist 1 1 successfully resolved the assigned authored task";
preservation- "This investigation deleted, moved, or recreated none of the eight entries and did not alter unknown artifacts";
);

decisions: (
operator_evidence_limit- "Operator explicitly accepted the documented evidence limit: the missing attributable witness prevents reconstruction of the untracked lifecycle; creator, creation workflow, ownership-at-creation, runtime purpose, and disappearance mechanism remain unproven";
preservation_boundary- "Deletion authority is NOT GRANTED; unknown artifacts remain preserve-first. Acceptance of the evidence limit grants no disposal authority";
completion_boundary- "Completion accepts the bounded investigation and validated documentation, not a proven artifact lifecycle; task scope is unchanged";
acceptance_boundary- "Do not run qps Save, stage, or commit in this assignment";
);

next- "Complete under the Operator-accepted evidence limit; retain the unresolved findings and preserve-first policy. Save and Git acceptance remain outside this assignment";

done_when: (
condition_1- "_index.qps, goals.qps, checklist.qps, and history.qps pass applicable QPS validation";
condition_2- "Root authority documents have explicit non-conflicting roles";
condition_3- "No unknown repository entry is deleted because it is empty, malformed-looking, untracked, generated-looking, or unreferenced; deletion requires positive disposability evidence or explicit authority";
condition_4- "qps checklist regenerates successfully after reconciliation";
);
);

);
);

task_2: (
identity- "package.reconcile_with_repository";
summary- "Reconcile package/ against current repository state and ensure all connections are established";
state- "complete";
meaning- "The package/ directory has evolved significantly but may not be fully integrated with the root CE-OS authority model and other surfaces";
