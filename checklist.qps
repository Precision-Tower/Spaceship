task_4: (
identity- "package.pixel_provisioning_environment_design";
summary- "Design the custom provisioning environment that runs on the unlocked Pixel 6 to install CE-OS on target hardware";
state- "active";
meaning- "Leverage the unlocked Pixel 6 bootloader to safely boot a custom provisioning environment that presents the Ubuntu LTS autoinstall payload and CE-OS seed to a target machine";
findings: (
bootloader_state- "UNLOCKED (ro.boot.flash.locked=0, verifiedbootstate=orange)";
safety_status- "PASS: 'fastboot boot' allows RAM-only execution without flashing or wiping, satisfying all safety constraints";
);
architecture_options: (
option_1_usb_mass_storage- "Pixel acts as a USB boot drive. Target boots from Pixel. Requires USB gadget mass storage configuration in custom environment.";
option_2_pxe_network_boot- "Pixel acts as a local network boot server (DHCP/TFTP/HTTP). Target boots via PXE over USB Ethernet gadget. More reliable than USB mass storage booting from Android.";
recommended- "option_2_pxe_network_boot (with option_1 as fallback)";
);
steps: (
step_1: (
goal- "Design the minimal Linux initramfs or custom recovery image structure";
state- "complete";
);
step_2: (
goal- "Define the USB gadget configuration (RNDIS/Ethernet + optional Mass Storage)";
state- "complete";
);
step_3: (
goal- "Create the provisioning UI/CLI (simple menu to trigger target installation)";
state- "waiting";
);
step_4: (
goal- "Build and test 'fastboot boot' provisioning image in trash/tmp/";
state- "waiting";
);
);
);
