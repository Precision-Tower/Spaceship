HEV_DC_Motor_Relationship.

{DC_Motor_Electromagnetic_State:
[>voltage_vdc]-
[>current_a]-
[>electrical_resistance_ohm]-
[>torque_constant]-
[>back_emf_constant]-

%[>resistive_voltage_drop]: current_a * electrical_resistance_ohm
%[>back_emf]: voltage_vdc - resistive_voltage_drop
%[>shaft_torque]: current_a * torque_constant
%[>angular_velocity]: back_emf / back_emf_constant
}

{>DC_Motor_Electromagnetic_State:
voltage_vdc- 12/n;
current_a- 10/n;
electrical_resistance_ohm- 0.2/n;
torque_constant- 0.05/n;
back_emf_constant- 0.05/n;
}

tests.

relationship_execution: -test {
    %resistive_voltage_drop: 10 * 0.2
    %back_emf: 12 - resistive_voltage_drop
    %shaft_torque: 10 * 0.05
    %angular_velocity: back_emf / 0.05

    -assert resistive_voltage_drop == 2;
    -assert back_emf == 10;
    -assert shaft_torque == 0.5;
    -assert angular_velocity == 200;
};
