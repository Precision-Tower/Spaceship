ICE. Internal_Combustion_Engine: def"
Internal Combustion is the process of turning explosions into motion.

Recovered from the historical QPS Engineering design source without
normalizing the author's domain taxonomy into conventional physics notation.
";

identity: (
system- "ICE"/a;
full_name- "Internal Combustion Engine"/a;
historical_source- "C:/Users/Freed/1/Dashboard/QPS_recovery/Engineering/qps/design/designs/ICE.qps"/a;
recovery_status- "normalized_active_qps"/a;
);

model_rules: (
domain_transformations_are_not_numeric_equality- true/b;
branches_are_causal_graph_edges- true/b;
authored_mismatches_are_preserved- true/b;
unknown_values_remain_unknown- true/b;
);

types: (
piston: def"
A common type of ICE that burns gasoline to produce mechanical power.
";
rotor: def"
A type of ICE that uses a rotary design to convert fuel into mechanical energy.
";
diesel: def"
An ICE that uses diesel fuel, known for its efficiency and torque characteristics.
";
);

historical_processes: (
starter_process- "Battery: (Ec: DC), Electric_Motor: (DC = ME), Flywheel: (ME)"/a;
combustion_process- "Combustion: (FD), Piston: (FD = ME), Crankshaft: (ME = ME), Flywheel: (ME), Transmission: (ME), Differential: (ME), Tires: (ME)"/a;
cam_shaft_process- "Combustion: (FD), Piston: (FD = ME), Crankshaft: (ME), Internal_Pulley: (ME), Cam_Shaft_Pulley: (ME), Cam_Shaft: (ME)"/a;
water_pump_process- "Combustion: (FD), Piston: (FD = ME), Crankshaft: (ME), Internal_Pulley: (ME), Water_Pump: (ME = FD), Radiator: (ME = TE)"/a;
battery_charger- "Combustion: (FD), Piston: (FD = ME), Crankshaft: (ME), Master_Pulley: (ME), Alternator: (ME = AC), Battery: (DC)"/a;
spark_plugs- "Combustion: (FD), Piston: (FD = ME), Crankshaft: (ME), Master_Pulley: (ME), Alternator: (ME = AC), PWM: (DC), Coil_Pack: (DC), Spark_Plug: (DC)"/a;
condenser_process- "Combustion: (FD), Piston: (FD = ME), Crankshaft: (ME), Master_Pulley: (ME), Compressor: (ME = FD), Condenser: (ME = TE)"/a;
power_steering_process- "Combustion: (FD), Piston: (FD = ME), Crankshaft: (ME), Master_Pulley: (ME), Power_Steering_Pump: (ME = FD), Steering_Rack: (ME)"/a;
);

