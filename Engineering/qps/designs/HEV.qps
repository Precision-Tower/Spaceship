HEV. Hydraulic_Electric_System: def"
The Hydraulic Electric System is a closed rotary causal system under investigation.

Its central architecture is:

DC electrical
-> rotational mechanical
-> fluid dynamics
-> rotational mechanical
-> AC electrical
-> DC electrical
-> repeat

The HEV model does not assume that the loop succeeds or fails.

The purpose of this definition is to expose every causal relationship,
state variable, resistance, displacement, geometry, and observable
required to compare the predicted system against the real system.

Efficiency is not an authoritative primitive of this model.
Any efficiency ratio may be derived afterward from measured states,
but must not replace the physical relationships that produced them.
";

identity: (
system- "HEV"/a;
full_name- "Hydraulic Electric System"/a;
model_version- 1;
status- "active_hypothesis"/a;
verdict- "unresolved"/a;
);

origin: (
purpose- "test the HEV as a fully causal physical system"/a;
primary_question- "can the coupled system establish a sustained operating state"/a;
authoritative_hypothesis- "Engineering/docs/Engineering.md"/a;
historical_design- "Engineering/qps/Archive/qps/design/designs/HEV.qps"/a;
);

model_rules: (
relationships_not_summary_metrics- true/b;
efficiency_is_derived_only- true/b;
resistance_must_be_explicit- true/b;
displacement_must_be_explicit- true/b;
domain_bridges_must_be_explicit- true/b;
geometry_must_be_explicit_where_relevant- true/b;
measured_state_must_remain_distinct_from_predicted_state- true/b;
unknown_values_remain_unknown- true/b;
no_hidden_energy_source- true/b;
no_hidden_energy_sink- true/b;
);

causal_chain: (
stage_1- "battery -> dc_motor"/a;
stage_2- "dc_motor -> pump"/a;
stage_3- "pump -> circulating_water"/a;
stage_4- "circulating_water -> hydraulic_turbine"/a;
stage_5- "hydraulic_turbine -> alternator"/a;
stage_6- "alternator -> rectification_and_charge_control"/a;
stage_7- "rectification_and_charge_control -> battery"/a;
);

domain_chain: (
domain_1- "DC"/a;
domain_2- "ME"/a;
domain_3- "FD"/a;
domain_4- "ME"/a;
domain_5- "AC"/a;
domain_6- "DC"/a;
);

