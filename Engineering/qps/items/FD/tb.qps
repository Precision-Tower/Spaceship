tb. Turbine: def"A turbine is a device that resolves linear fluid motion into mechanical energy. Its function is governed by the causal relationship: (FD) = (ME).";
input: (
fm-/n;
fr-/n;
);
output: (
mv-/n;
rpm-/n;
);

ww. Water_Wheel: def"A passive turbine driven by ambient liquid flow. No pressure vessel. Resolution is open-air flow into shaft torque.";
dimensions: (
wheel: (
radius-/n;
width-/n;
blade_count-/n;
shaft_radius-/n;
shaft_length-/n;
);
slave: (
radius-/n;
width-/n;
);
);

wt. Wind_Turbine: def"A turbine that resolves ambient wind fluid momentum into rotational mechanical energy. Operates in an open field configuration.";
dimensions: (
rotor: (
radius-/n;
blade_count-/n;
slope-/n;
material-/a;
shaft_radius-/n;
shaft_length-/n;
);
slave: (
radius-/n;
width-/n;
);
);

ht. Hydraulic_Turbine: def"A pressure-driven turbine using a contained liquid, typically water, to drive an impeller in a housing.";
