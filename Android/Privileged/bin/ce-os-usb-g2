#!/data/data/com.termux/files/usr/bin/python

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

ROOT = Path("/data/data/com.termux/files/home/ce-os")

CONFIGFS = Path("/config/usb_gadget")
G1 = CONFIGFS / "g1"
G2 = CONFIGFS / "ceos"

IMAGE = Path("/data/data/com.termux/files/home/ubuntu-26.04.1-live-server-amd64.iso")

VENDOR = "0x1d6b"
PRODUCT = "0x0104"

SERIAL = "CEOS-PIXEL-BOOTSTRAP"
MANUFACTURER = "CE-OS"
PRODUCT_NAME = "CE-OS Bootstrap"


def write(path: Path, value: str) -> None:
    path.write_text(value)


def status() -> dict:
    function = G2 / "functions/mass_storage.ceos"
    lun = function / "lun.0"

    links = {}

    config = G2 / "configs/c.1"

    if config.is_dir():
        for path in config.iterdir():
            if path.is_symlink():
                links[path.name] = os.readlink(path)

    return {
        "ok": True,
        "operation": "g2.status",
        "exists": G2.is_dir(),
        "udc": (G2 / "UDC").read_text().strip()
            if (G2 / "UDC").is_file()
            else None,
        "image": str(IMAGE),
        "image_exists": IMAGE.is_file(),
        "function_exists": function.is_dir(),
        "lun_exists": lun.is_dir(),
        "read_only": (
            (lun / "ro").read_text().strip()
            if (lun / "ro").is_file()
            else None
        ),
        "backing_file": (
            (lun / "file").read_text().strip()
            if (lun / "file").is_file()
            else None
        ),
        "links": links,
        "g1_udc": (
            (G1 / "UDC").read_text().strip()
            if (G1 / "UDC").is_file()
            else None
        ),
    }


def create() -> dict:
    if os.geteuid() != 0:
        return {
            "ok": False,
            "operation": "g2.create",
            "error": "root_required",
        }

    if not IMAGE.is_file():
        return {
            "ok": False,
            "operation": "g2.create",
            "error": "bootstrap_image_missing",
        }

    G2.mkdir(exist_ok=True)

    write(G2 / "idVendor", VENDOR)
    write(G2 / "idProduct", PRODUCT)

    strings = G2 / "strings/0x409"
    strings.mkdir(parents=True, exist_ok=True)

    write(strings / "serialnumber", SERIAL)
    write(strings / "manufacturer", MANUFACTURER)
    write(strings / "product", PRODUCT_NAME)

    config = G2 / "configs/c.1"
    config.mkdir(parents=True, exist_ok=True)

    config_strings = config / "strings/0x409"
    config_strings.mkdir(parents=True, exist_ok=True)

    write(config_strings / "configuration", "CE-OS read-only bootstrap")

    function = G2 / "functions/mass_storage.ceos"

    if not function.exists():
        function.mkdir()

    lun = function / "lun.0"

    if not lun.is_dir():
        return {
            "ok": False,
            "operation": "g2.create",
            "error": "mass_storage_lun_missing",
        }

    if (lun / "ro").exists():
        write(lun / "ro", "1")

    if (lun / "removable").exists():
        write(lun / "removable", "1")

    write(lun / "file", str(IMAGE))

    link = config / "mass_storage.ceos"

    if not link.exists():
        os.symlink(str(function), link)

    # Hard safety boundary:
    # this helper does not bind g2 to any UDC.
    if (G2 / "UDC").read_text().strip():
        return {
            "ok": False,
            "operation": "g2.create",
            "error": "g2_unexpectedly_bound",
        }

    result = status()
    result["operation"] = "g2.create"

    required = [
        result["exists"],
        result["image_exists"],
        result["function_exists"],
        result["lun_exists"],
        result["read_only"] == "1",
        result["backing_file"] == str(IMAGE),
        result["udc"] == "",
    ]

    result["ok"] = all(required)

    return result


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "status"

    if command == "status":
        result = status()
    elif command == "create":
        result = create()
    else:
        result = {
            "ok": False,
            "error": "unknown_command",
            "command": command,
        }

    print(json.dumps(result, indent=2, sort_keys=True))

    return 0 if result.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main())
