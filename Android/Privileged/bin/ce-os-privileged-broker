#!/data/data/com.termux/files/usr/bin/python

from __future__ import annotations

import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

HOME = Path("/data/data/com.termux/files/home")
ROOT = HOME / "ce-os"

RUN_DIR = ROOT / "run"
SOCKET_PATH = RUN_DIR / "privileged.sock"
AUDIT_LOG = ROOT / "logs/privileged-audit.log"
BOOTSTRAP_LEASE_SECONDS = 30

ALLOWED_OPERATIONS = {
    "health",
    "platform.verify",
    "bootstrap.preflight",
    "bootstrap.status",
    "bootstrap.enable",
    "bootstrap.disable",
}

RESERVED_OPERATIONS = {
    "installer.enable",
    "installer.disable",
    "snapshot.create",
}


def audit(operation: str, result: str, detail: str = "") -> None:
    AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)

    with AUDIT_LOG.open("a", encoding="utf-8") as handle:
        handle.write(
            json.dumps(
                {
                    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                    "operation": operation,
                    "result": result,
                    "detail": detail,
                },
                sort_keys=True,
            )
            + "\n"
        )


def response(ok: bool, **extra):
    payload = {"ok": ok}
    payload.update(extra)
    return payload


def key_value_fields(text: str) -> dict[str, str]:
    fields = {}

    for line in text.splitlines():
        if "=" not in line:
            continue

        key, value = line.split("=", 1)
        fields[key.strip()] = value.strip()

    return fields


def platform_verify():
    command = [
        sys.executable,
        str(ROOT / "bin/ce-os"),
        "--json",
        "verify",
    ]

    proc = subprocess.run(
        command,
        cwd=str(ROOT),
        capture_output=True,
        text=True,
        check=False,
        timeout=15,
    )

    if proc.returncode != 0:
        return response(
            False,
            operation="platform.verify",
            error="verification_failed",
            stderr=proc.stderr.strip(),
        )

    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return response(
            False,
            operation="platform.verify",
            error="invalid_verifier_output",
        )

    return response(
        bool(payload.get("ok")),
        operation="platform.verify",
        platform=payload.get("platform"),
    )


def bootstrap_preflight():
    command = [
        str(ROOT / "bin/ce-os-usb-handoff"),
        "preflight",
    ]

    try:
        proc = subprocess.run(
            command,
            cwd=str(ROOT),
            capture_output=True,
            text=True,
            check=False,
            timeout=15,
        )
    except subprocess.TimeoutExpired:
        return response(
            False,
            operation="bootstrap.preflight",
            error="usb_handoff_preflight_timeout",
            timeout_seconds=15,
        )

    fields = key_value_fields(proc.stdout)
    ok = proc.returncode == 0 and fields.get("ok") == "true"

    result = response(
        ok,
        operation="bootstrap.preflight",
        code=proc.returncode,
        g1_udc=fields.get("g1_udc", ""),
        g2_udc=fields.get("g2_udc", ""),
        hal=fields.get("hal", ""),
        state=fields.get("state", ""),
    )

    if not ok:
        result["error"] = "usb_handoff_preflight_failed"
        result["stdout"] = proc.stdout.strip()
        result["stderr"] = proc.stderr.strip()

    return result


def dispatch(request):
    operation = str(request.get("operation", "")).strip()

    if operation == "health":
        audit(operation, "ok")
        return response(
            True,
            service="ce-os-privileged-broker",
            uid=os.geteuid(),
            operation="health",
        )

    if operation == "platform.verify":
        result = platform_verify()
        audit(
            operation,
            "ok" if result.get("ok") else "failed",
        )
        return result

    if operation == "bootstrap.preflight":
        result = bootstrap_preflight()
        audit(
            operation,
            "ok" if result.get("ok") else "failed",
        )
        return result

    if operation in {
        "bootstrap.status",
        "bootstrap.enable",
        "bootstrap.disable",
    }:
        helper_command = {
            "bootstrap.status": "status",
            "bootstrap.enable": "enable-test",
            "bootstrap.disable": "disable",
        }[operation]

        if operation == "bootstrap.enable":
            # Arm independent recovery before Android g1 loses the UDC.
            subprocess.Popen(
                [
                    str(ROOT / "bin/ce-os-usb-handoff"),
                    "watchdog",
                ],
                cwd=str(ROOT),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                close_fds=True,
            )

        try:
            proc = subprocess.run(
                [
                    str(ROOT / "bin/ce-os-usb-handoff"),
                    helper_command,
                ],
                cwd=str(ROOT),
                capture_output=True,
                text=True,
                check=False,
                timeout=15,
            )
        except subprocess.TimeoutExpired:
            audit(
                operation,
                "failed",
                "bootstrap_v2_timeout",
            )

            return response(
                False,
                operation=operation,
                error="usb_handoff_timeout",
                timeout_seconds=15,
            )

        fields = key_value_fields(proc.stdout)

        g1_udc = fields.get("g1_udc", "")
        g2_udc = fields.get("g2_udc", "")
        hal = fields.get("hal", "")
        state = fields.get("state", "")

        if g2_udc:
            effective_mode = "bootstrap"
        elif g1_udc:
            effective_mode = "android"
        else:
            effective_mode = "unbound"

        ok = proc.returncode == 0

        if operation == "bootstrap.enable":
            ok = ok and effective_mode == "bootstrap" and state == "ceos"
        elif operation == "bootstrap.disable":
            ok = ok and effective_mode == "android" and state == "android"

        result = response(
            ok,
            operation=operation,
            effective_mode=effective_mode,
            g1_udc=g1_udc,
            g2_udc=g2_udc,
            hal=hal,
            state=state,
        )

        if operation == "bootstrap.enable" and ok:
            result["lease_seconds"] = BOOTSTRAP_LEASE_SECONDS
            result["experimental"] = True

        if not ok:
            result["error"] = "usb_handoff_failed"
            result["returncode"] = proc.returncode
            result["stdout"] = proc.stdout.strip()
            result["stderr"] = proc.stderr.strip()

        audit(
            operation,
            "ok" if ok else "failed",
            "bootstrap_v2",
        )

        return result

    if operation in RESERVED_OPERATIONS:
        audit(operation, "denied", "reserved_not_implemented")
        return response(
            False,
            operation=operation,
            error="operation_not_implemented",
        )

    audit(operation or "<empty>", "denied", "unknown_operation")
    return response(
        False,
        operation=operation,
        error="operation_not_allowed",
    )


def handle_connection(conn):
    raw = b""

    while not raw.endswith(b"\n") and len(raw) < 16384:
        chunk = conn.recv(4096)
        if not chunk:
            break
        raw += chunk

    try:
        request = json.loads(raw.decode("utf-8"))
        if not isinstance(request, dict):
            raise ValueError("request must be object")

        result = dispatch(request)

    except Exception as exc:
        audit("<parse>", "failed", repr(exc))
        result = response(
            False,
            error="invalid_request",
        )

    conn.sendall(
        (json.dumps(result, sort_keys=True) + "\n").encode("utf-8")
    )


def main():
    RUN_DIR.mkdir(parents=True, exist_ok=True)

    try:
        SOCKET_PATH.unlink()
    except FileNotFoundError:
        pass

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(SOCKET_PATH))

    # Broker runs as root, but the socket belongs to the CE-OS
    # operator UID so the ordinary Termux runtime can connect.
    operator_ref = ROOT / "bin/ce-os"
    operator_stat = operator_ref.stat()

    os.chown(RUN_DIR, operator_stat.st_uid, operator_stat.st_gid)
    os.chmod(RUN_DIR, 0o700)

    os.chown(
        SOCKET_PATH,
        operator_stat.st_uid,
        operator_stat.st_gid,
    )
    os.chmod(SOCKET_PATH, 0o600)

    server.listen(8)

    audit("broker.start", "ok", f"uid={os.geteuid()}")

    while True:
        conn, _ = server.accept()

        with conn:
            handle_connection(conn)


if __name__ == "__main__":
    main()
