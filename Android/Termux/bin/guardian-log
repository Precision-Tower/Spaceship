#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
LOG="$ROOT/logs/power.csv"

# Compatibility command only.
# guardian-watch-root is the sole writer of privileged power telemetry.

if [[ ! -f "$LOG" ]]; then
    echo "NO POWER LOG"
    exit 1
fi

tail -n 20 "$LOG"
