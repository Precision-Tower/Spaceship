#!/data/data/com.termux/files/usr/bin/bash

BATTERY="$(su -c 'dumpsys battery')"
THERMAL="$(su -c 'dumpsys thermalservice')"

LEVEL="$(printf '%s\n' "$BATTERY" | awk '/  level:/ {print $2; exit}')"
AC="$(printf '%s\n' "$BATTERY" | awk '/AC powered:/ {print $3; exit}')"
USB="$(printf '%s\n' "$BATTERY" | awk '/USB powered:/ {print $3; exit}')"
TEMP="$(printf '%s\n' "$BATTERY" | awk '/temperature:/ {print $2; exit}')"

THERMAL_STATUS="$(printf '%s\n' "$THERMAL" | awk '/^Thermal Status:/ {print $3; exit}')"

if [[ "$AC" == "true" || "$USB" == "true" ]]; then
    SOURCE="external"
else
    SOURCE="battery"
fi

if [[ "$SOURCE" == "battery" && "$LEVEL" -le 20 ]]; then
    STATE="SURVIVAL"
elif [[ "$SOURCE" == "battery" ]]; then
    STATE="MOBILE"
else
    STATE="POWERED"
fi

case "$THERMAL_STATUS" in
    0) THERMAL="NOMINAL" ;;
    1) THERMAL="LIGHT" ;;
    2) THERMAL="MODERATE" ;;
    3) THERMAL="SEVERE" ;;
    4) THERMAL="CRITICAL" ;;
    5) THERMAL="EMERGENCY" ;;
    6) THERMAL="SHUTDOWN" ;;
    *) THERMAL="UNKNOWN" ;;
esac

printf 'node=pixel\n'
printf 'state=%s\n' "$STATE"
printf 'source=%s\n' "$SOURCE"
printf 'battery=%s\n' "$LEVEL"
printf 'battery_temp_c=%d.%d\n' "$((TEMP / 10))" "$((TEMP % 10))"
printf 'thermal=%s\n' "$THERMAL"
printf 'thermal_status=%s\n' "$THERMAL_STATUS"
