#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
LIVE="$ROOT/state/runtime/live.env"

if [[ ! -f "$LIVE" ]]; then
    echo "node=pixel"
    echo "state=SURVIVAL"
    echo "source=unknown"
    echo "battery=unknown"
    echo "battery_temp_c=unknown"
    echo "thermal=MODERATE"
    echo "thermal_status=unknown"
    exit 1
fi

declare -A V=()

while IFS='=' read -r key value; do
    [[ -n "$key" ]] || continue
    V["$key"]="$value"
done < "$LIVE"

POWER="${V[power_state]:-SURVIVAL}"
THERMAL="${V[thermal_state]:-MODERATE}"

case "$POWER" in
    POWERED) SOURCE="external" ;;
    MOBILE|SURVIVAL) SOURCE="battery" ;;
    *) SOURCE="unknown" ;;
esac

printf 'node=pixel\n'
printf 'state=%s\n' "$POWER"
printf 'source=%s\n' "$SOURCE"
printf 'battery=%s\n' "${V[battery]:-unknown}"
printf 'battery_temp_c=%s\n' "${V[battery_temp_c]:-unknown}"
printf 'thermal=%s\n' "$THERMAL"
printf 'thermal_status=%s\n' "${V[thermal_status]:-unknown}"
