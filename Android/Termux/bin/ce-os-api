#!/data/data/com.termux/files/usr/bin/python

from __future__ import annotations

import json
import hmac
import socket
import subprocess
import sys
from urllib.parse import parse_qs, urlparse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOME = Path("/data/data/com.termux/files/home")
ROOT = HOME / "ce-os"

TERMUX_ROOT = ROOT / "Android/Termux"
sys.path.insert(0, str(TERMUX_ROOT))

from services.ce_os.guardian import evaluate_state
from services.ce_os.state import load_state, request_mode, save_state

STATE = ROOT / "state/runtime/state.json"
LIVE = ROOT / "state/runtime/live.env"
TOKEN_FILE = ROOT / "config/private/api-token"
PRIV_SOCKET = ROOT / "run/privileged.sock"

HOST = "127.0.0.1"
PORT = 8765

ALLOWED_MODES = {
    "node",
    "conserve",
    "bootstrap",
}


def current_state():
    state = evaluate_state(load_state(STATE))
    return state



def _run_read_only(command: list[str], timeout: float = 2.0) -> tuple[int, str]:
    """Run a bounded observation command. Never mutates host state."""
    try:
        proc = subprocess.run(
            command,
            cwd=str(ROOT),
            capture_output=True,
            text=True,
            check=False,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired):
        return 127, ""
    return proc.returncode, proc.stdout.strip()


def _run_root_read_only(script: str, timeout: float = 3.0) -> tuple[int, str]:
    return _run_read_only(["su", "-c", script], timeout)


def _service_state(name: str) -> str:
    service = HOME / "../usr/var/service" / name
    code, out = _run_read_only(["sv", "status", str(service)])
    if code == 0 and out.startswith("run:"):
        return "ok"
    if out.startswith(("down:", "finish:")):
        return "degraded"
    if out:
        return "unknown"
    return "unknown"


def _package_suspended(package: str) -> str:
    code, out = _run_root_read_only(
        f'dumpsys package {package} 2>/dev/null | grep -m1 "User 0:"'
    )
    if code != 0 or not out:
        return "unknown"
    if "suspended=true" in out:
        return "true"
    if "suspended=false" in out:
        return "false"
    return "unknown"


def classify_host_snapshot(observed: dict) -> dict:
    """Normalize read-only host evidence and derive warnings deterministically."""
    services = dict(observed.get("services") or {})
    network = dict(observed.get("network") or {})
    security = dict(observed.get("security") or {})
    lifecycle = dict(observed.get("lifecycle") or {})
    storage = dict(observed.get("storage") or {})

    warnings = []

    for name, value in sorted(services.items()):
        if value != "ok":
            warnings.append(f"service_{name}_{value}")

    hotspot = network.get("hotspot_interface", "unknown")
    ssh_listener = network.get("ssh_listener", "unknown")
    ssh_rule = network.get("ssh_firewall_rule", "unknown")

    if hotspot not in {"up", "present"}:
        warnings.append(f"hotspot_{hotspot}")
    if ssh_listener != "listening":
        warnings.append(f"ssh_{ssh_listener}")
    if ssh_rule != "present":
        warnings.append(f"ssh_firewall_{ssh_rule}")

    selinux = security.get("selinux", "unknown")
    if selinux != "enforcing":
        warnings.append(f"selinux_{selinux}")

    if security.get("verified_boot") == "orange":
        warnings.append("verified_boot_orange")

    if security.get("bootloader") == "unlocked":
        warnings.append("bootloader_unlocked")

    if lifecycle.get("termux_suspended") == "true":
        warnings.append("termux_suspended")

    if lifecycle.get("magisk_suspended") == "true":
        warnings.append("magisk_manager_suspended")

    usage = storage.get("data_percent")
    try:
        if usage is not None and int(usage) >= 90:
            warnings.append("storage_pressure")
    except (TypeError, ValueError):
        pass

    if any(value == "unknown" for value in services.values()):
        warnings.append("evidence_incomplete")

    if warnings:
        if any(
            item.startswith(("service_", "hotspot_", "ssh_", "selinux_", "termux_"))
            for item in warnings
        ):
            overall = "degraded"
        else:
            overall = "attention"
    else:
        overall = "healthy"

    return {
        "overall": overall,
        "services": services,
        "network": network,
        "security": security,
        "lifecycle": lifecycle,
        "storage": storage,
        "warnings": warnings,
        "read_only": True,
    }


def host_snapshot() -> dict:
    """Collect bounded host observations for the operator panel only."""
    services = {
        "api": _service_state("ce-os-api"),
        "live_sync": _service_state("ce-os-live-sync"),
        "guardian": _service_state("ce-os-guardian"),
        "privileged_broker": _service_state("ce-os-privileged-broker"),
    }

    _, hotspot = _run_root_read_only(
        'if ip link show ap_br_wlan2 >/dev/null 2>&1; then echo up; else echo absent; fi'
    )
    _, ssh_listener = _run_root_read_only(
        'if ss -lntH 2>/dev/null | grep -Eq ":(8022)[[:space:]]"; then echo listening; else echo absent; fi'
    )
    _, ssh_rule = _run_root_read_only(
        'if iptables -S INPUT 2>/dev/null | grep -q -- "--dport 8022"; then echo present; else echo absent; fi'
    )

    _, selinux = _run_root_read_only('getenforce 2>/dev/null || echo unknown')
    _, root_uid = _run_root_read_only('id -u')
    _, verified_boot = _run_read_only(["getprop", "ro.boot.verifiedbootstate"])
    _, bootloader = _run_read_only(["getprop", "ro.boot.vbmeta.device_state"])

    _, data_percent_raw = _run_read_only(
        ["sh", "-c", "df -P /data 2>/dev/null | awk 'NR==2 {gsub(/%/,\"\",$5); print $5}'"]
    )

    observed = {
        "services": services,
        "network": {
            "hotspot_interface": hotspot or "unknown",
            "ssh_listener": ssh_listener or "unknown",
            "ssh_firewall_rule": ssh_rule or "unknown",
            "control_plane": {
                "ssh": "preserved",
                "hotspot": "preserved",
            },
        },
        "security": {
            "selinux": (selinux or "unknown").lower(),
            "root_available": root_uid == "0",
            "verified_boot": verified_boot or "unknown",
            "bootloader": bootloader or "unknown",
        },
        "lifecycle": {
            "termux_suspended": _package_suspended("com.termux"),
            "magisk_suspended": _package_suspended("com.topjohnwu.magisk"),
        },
        "storage": {
            "data_percent": data_percent_raw or "unknown",
        },
    }

    return classify_host_snapshot(observed)


def state_payload():
    state = current_state()

    payload = {
        "node": "pixel",
        "requested_mode": state.requested_mode,
        "effective_mode": state.effective_mode,
        "platform_state": state.platform_state,
        "requested_usb_mode": state.requested_usb_mode,
        "usb_mode": state.usb_mode,
        "allow_compute": state.allow_compute,
        "power_state": state.power_state,
        "thermal_state": state.thermal_state,
        "guardian_reasons": state.guardian_reasons,
        "control_plane": state.control_plane,
    }

    payload["host"] = host_snapshot()

    if LIVE.exists():
        live = {}
        for line in LIVE.read_text(encoding="utf-8").splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                live[key] = value
        payload["telemetry"] = live

    return payload


def set_mode(mode: str):
    if mode not in ALLOWED_MODES:
        raise ValueError("unsupported mode")

    state = load_state(STATE)
    state = request_mode(state, mode)
    state = evaluate_state(state)
    save_state(state, STATE)

    return state_payload()


def resolve_authorized_path(raw_path: str | None) -> Path:
    root = ROOT.resolve()
    if raw_path is None or raw_path.strip() == "":
        return root

    candidate = raw_path.strip()
    if candidate in {"/", "."}:
        return root

    if candidate.startswith("~"):
        candidate = candidate[1:].lstrip("/")

    if candidate.startswith("/"):
        target = (root / candidate.lstrip("/")).resolve(strict=False)
    else:
        target = (root / candidate).resolve(strict=False)

    try:
        target.relative_to(root)
    except ValueError as exc:
        raise ValueError("path outside authorized root") from exc

    return target


def _repo_relative_path(path: Path) -> str:
    relative = path.relative_to(ROOT.resolve())
    return "/" + relative.as_posix() if relative.as_posix() != "." else "/"


def list_repo_entries(repo_relative_path: str | None = None) -> dict:
    target = resolve_authorized_path(repo_relative_path)

    if not target.exists():
        return {"ok": False, "error": "not_found", "path": _repo_relative_path(target)}
    if not target.is_dir():
        return {"ok": False, "error": "not_directory", "path": _repo_relative_path(target)}

    entries = []
    for child in target.iterdir():
        entries.append({
            "name": child.name,
            "path": _repo_relative_path(child),
            "type": "directory" if child.is_dir() else "file",
        })

    entries.sort(key=lambda entry: (0 if entry["type"] == "directory" else 1, entry["name"].lower()))

    return {
        "ok": True,
        "path": _repo_relative_path(target),
        "entries": entries,
    }


def read_repo_file(repo_relative_path: str | None) -> dict:
    target = resolve_authorized_path(repo_relative_path)

    if not target.exists():
        return {"ok": False, "error": "not_found", "path": _repo_relative_path(target)}
    if not target.is_file():
        return {"ok": False, "error": "not_regular_file", "path": _repo_relative_path(target)}

    try:
        content = target.read_text(encoding='utf-8')
    except UnicodeDecodeError:
        return {
            "ok": False,
            "error": "binary_not_supported",
            "path": _repo_relative_path(target),
            "size": target.stat().st_size,
        }

    return {
        "ok": True,
        "path": _repo_relative_path(target),
        "content": content,
        "size": len(content.encode('utf-8')),
    }


def bootstrap_policy() -> tuple[bool, dict]:
    """Return whether canonical CE-OS state permits BOOTSTRAP realization."""
    state = current_state()

    checks = {
        "requested_mode": state.requested_mode == "bootstrap",
        "effective_mode": state.effective_mode == "bootstrap",
        "requested_usb_mode": state.requested_usb_mode == "bootstrap",
        "platform_state": state.platform_state == "ok",
        "power_state": state.power_state == "POWERED",
        "thermal_state": state.thermal_state in {"NOMINAL", "LIGHT"},
    }

    return all(checks.values()), {
        "checks": checks,
        "requested_mode": state.requested_mode,
        "effective_mode": state.effective_mode,
        "requested_usb_mode": state.requested_usb_mode,
        "usb_mode": state.usb_mode,
        "platform_state": state.platform_state,
        "power_state": state.power_state,
        "thermal_state": state.thermal_state,
        "guardian_reasons": state.guardian_reasons,
    }


def valid_token(value: str | None) -> bool:
    if not value or not TOKEN_FILE.exists():
        return False

    expected = TOKEN_FILE.read_text(encoding="utf-8").strip()

    return bool(expected) and hmac.compare_digest(
        value.strip(),
        expected,
    )


def privileged_request(operation: str) -> dict:
    allowed = {
        "health",
        "platform.verify",
        "bootstrap.status",
        "bootstrap.enable",
        "bootstrap.disable",
    }

    if operation not in allowed:
        raise ValueError("privileged operation not allowed")

    request = json.dumps(
        {"operation": operation}
    ).encode("utf-8") + b"\n"

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(15)

    try:
        sock.connect(str(PRIV_SOCKET))
        sock.sendall(request)

        raw = b""

        while not raw.endswith(b"\n") and len(raw) < 262144:
            chunk = sock.recv(4096)

            if not chunk:
                break

            raw += chunk

        return json.loads(raw.decode("utf-8"))
    finally:
        sock.close()


class Handler(BaseHTTPRequestHandler):

    def send_json(self, status: int, payload):
        body = json.dumps(payload, indent=2).encode("utf-8")

        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()

        self.wfile.write(body)

    def do_GET(self):
        privileged_paths = {
            "/v1/privileged/health": "health",
            "/v1/privileged/platform/verify": "platform.verify",
            "/v1/privileged/bootstrap/status": "bootstrap.status",
        }

        if self.path in privileged_paths:
            token = self.headers.get("X-CEOS-Token")

            if not valid_token(token):
                self.send_json(
                    401,
                    {"ok": False, "error": "unauthorized"},
                )
                return

            try:
                payload = privileged_request(
                    privileged_paths[self.path]
                )
                self.send_json(
                    200 if payload.get("ok") else 503,
                    payload,
                )
            except Exception as exc:
                self.send_json(
                    503,
                    {
                        "ok": False,
                        "error": "privileged_broker_unavailable",
                        "detail": str(exc),
                    },
                )

            return

        if self.path == "/v1/status":
            self.send_json(200, state_payload())
            return

        if self.path == "/v1/health":
            self.send_json(
                200,
                {
                    "service": "ce-os-api",
                    "node": "pixel",
                    "status": "ok",
                },
            )
            return

        if self.path.startswith("/v1/fs/"):
            parsed = urlparse(self.path)
            query = parse_qs(parsed.query)
            requested_path = query.get("path", [""])[0]
            try:
                if parsed.path == "/v1/fs/list":
                    payload = list_repo_entries(requested_path)
                elif parsed.path == "/v1/fs/read":
                    payload = read_repo_file(requested_path)
                else:
                    payload = {"ok": False, "error": "not_found"}
                self.send_json(200 if payload.get("ok") else 400, payload)
            except ValueError as exc:
                self.send_json(400, {"ok": False, "error": "path_outside_authorized_root", "detail": str(exc)})
            return

        self.send_json(404, {"error": "not found"})

    def do_POST(self):
        privileged_paths = {
            "/v1/privileged/bootstrap/enable": "bootstrap.enable",
            "/v1/privileged/bootstrap/disable": "bootstrap.disable",
        }

        if self.path in privileged_paths:
            token = self.headers.get("X-CEOS-Token")

            if not valid_token(token):
                self.send_json(
                    401,
                    {
                        "ok": False,
                        "error": "unauthorized",
                    },
                )
                return

            operation = privileged_paths[self.path]

            # Disable is deliberately always available to an authenticated
            # caller because returning ownership to Android is a recovery
            # operation.
            if operation == "bootstrap.enable":
                allowed, policy = bootstrap_policy()

                if not allowed:
                    self.send_json(
                        409,
                        {
                            "ok": False,
                            "error": "bootstrap_policy_denied",
                            "policy": policy,
                        },
                    )
                    return

                try:
                    hardware = privileged_request("bootstrap.status")
                except (OSError, ValueError, json.JSONDecodeError):
                    self.send_json(
                        503,
                        {
                            "ok": False,
                            "error": "privileged_broker_unavailable",
                        },
                    )
                    return

                if (
                    hardware.get("ok")
                    and hardware.get("effective_mode") == "bootstrap"
                ):
                    hardware["already_active"] = True
                    self.send_json(200, hardware)
                    return

            try:
                payload = privileged_request(operation)
            except (OSError, ValueError, json.JSONDecodeError):
                self.send_json(
                    503,
                    {
                        "ok": False,
                        "error": "privileged_broker_unavailable",
                    },
                )
                return

            self.send_json(
                200 if payload.get("ok") else 409,
                payload,
            )
            return

        if self.path.startswith("/v1/mode/"):
            mode = self.path.rsplit("/", 1)[-1].lower()

            try:
                payload = set_mode(mode)
            except ValueError:
                self.send_json(
                    400,
                    {
                        "error": "unsupported mode",
                        "allowed": sorted(ALLOWED_MODES),
                    },
                )
                return

            self.send_json(200, payload)
            return

        self.send_json(404, {"error": "not found"})

    def log_message(self, fmt, *args):
        return


def main():
    server = ThreadingHTTPServer((HOST, PORT), Handler)

    print(f"CE-OS API listening on http://{HOST}:{PORT}")
    server.serve_forever()


if __name__ == "__main__":
    main()
