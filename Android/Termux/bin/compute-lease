#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
CEOS="$ROOT/Android/Termux/bin/ce-os"

ALLOW="$(
    "$CEOS" --json status |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["state"]["allow_compute"])'
)"

if [[ "$ALLOW" == "1" ]]; then
    echo "granted"
    exit 0
fi

echo "denied"
exit 1
