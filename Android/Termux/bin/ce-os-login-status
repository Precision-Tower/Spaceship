#!/data/data/com.termux/files/usr/bin/bash

ROOT="$HOME/ce-os"
CEOS="$ROOT/Android/Termux/bin/ce-os"
SIZE_CACHE="$ROOT/state/runtime/ceos-size.cache"

RESET='\033[0m'
PLUM='\033[38;5;54m'
CYAN='\033[38;5;37m'

echo
printf "${PLUM}PIXEL 69${RESET}  CE-OS NODE\n"

# ------------------------------------------------------------
# CE-OS
# ------------------------------------------------------------

if [[ -x "$CEOS" ]]; then
    "$CEOS" --json status 2>/dev/null |
    python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)["state"]
    print(
        "CE-OS     mode={}  compute={}  thermal={}  power={}".format(
            d.get("effective_mode", "?"),
            d.get("allow_compute", "?"),
            d.get("thermal_state", "?"),
            d.get("power_state", "?"),
        )
    )
except Exception:
    pass
'
fi

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------

df -h "$ROOT" 2>/dev/null |
awk 'NR==2 {
    printf "Disk      used=%s  free=%s  total=%s  (%s)\n",
           $3, $4, $2, $5
}'

if [[ -s "$SIZE_CACHE" ]]; then
    echo "CE-OS     tree=$(cat "$SIZE_CACHE")"
else
    echo "CE-OS     tree=calculating"
fi

# Refresh only when CE-OS permits compute, and never more than once
# every six hours. SSH login must not create background work while
# the guardian is shedding compute.
ALLOW_REFRESH="$(
    "$CEOS" --json status 2>/dev/null |
    python3 -c 'import json,sys
try:
    print(json.load(sys.stdin)["state"]["allow_compute"])
except Exception:
    print(0)
' 2>/dev/null
)"

if [[ "$ALLOW_REFRESH" == "1" ]] &&
   { [[ ! -f "$SIZE_CACHE" ]] ||
     [[ -n "$(find "$SIZE_CACHE" -mmin +360 -print 2>/dev/null)" ]]; }; then
    (
        nice -n 19 du -sh "$ROOT" 2>/dev/null |
        awk '{print $1}' > "$SIZE_CACHE.tmp" &&
        mv "$SIZE_CACHE.tmp" "$SIZE_CACHE"
    ) >/dev/null 2>&1 &
fi

# ------------------------------------------------------------
# CPU
# ------------------------------------------------------------

AVAILABLE="$(nproc 2>/dev/null || echo '?')"

PHYSICAL="$(
    find /sys/devices/system/cpu \
      -maxdepth 1 -type d -name 'cpu[0-9]*' 2>/dev/null |
    wc -l
)"

echo "CPU       physical=$PHYSICAL  available=$AVAILABLE"

FREQS="$(
    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq; do
        [[ -r "$f" ]] || continue
        cat "$f"
    done 2>/dev/null |
    awk '
        {
            total += $1
            count++
            if ($1 > max) max=$1
        }
        END {
            if (count)
                printf "avg=%.2fGHz  peak=%.2fGHz",
                       total/count/1000000,
                       max/1000000
        }
    '
)"

[[ -n "$FREQS" ]] && echo "Clock     $FREQS"

echo
printf "${CYAN}TOP CPU${RESET}\n"

ps -eo pid,pcpu,pmem,args --sort=-pcpu 2>/dev/null |
awk '
    NR==1 {
        printf "%-7s %6s %6s %s\n",$1,$2,$3,$4
        next
    }
    NR<=6 {
        cmd=""
        for (i=4;i<=NF;i++) cmd=cmd (i==4?"":" ") $i
        if (length(cmd)>55) cmd=substr(cmd,1,52) "..."
        printf "%-7s %6s %6s %s\n",$1,$2,$3,cmd
    }
'

echo
