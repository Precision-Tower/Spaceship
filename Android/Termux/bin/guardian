#!/data/data/com.termux/files/usr/bin/bash

POWER="$("$HOME/ce-os/bin/power-state")"

STATE="$(printf '%s\n' "$POWER" | awk -F= '/^state=/{print $2}')"
THERMAL_STATUS="$(printf '%s\n' "$POWER" | awk -F= '/^thermal_status=/{print $2}')"
BATTERY="$(printf '%s\n' "$POWER" | awk -F= '/^battery=/{print $2}')"
TEMP="$(printf '%s\n' "$POWER" | awk -F= '/^battery_temp_c=/{print $2}')"

case "$STATE:$THERMAL_STATUS" in
    SURVIVAL:*)
        MODE="SURVIVAL"
        ALLOW_COMPUTE=0
        ;;
    MOBILE:*)
        MODE="MOBILE"
        ALLOW_COMPUTE=0
        ;;
    POWERED:0|POWERED:1)
        MODE="POWERED"
        ALLOW_COMPUTE=1
        ;;
    POWERED:*)
        MODE="THERMAL_SHED"
        ALLOW_COMPUTE=0
        ;;
    *)
        MODE="SAFE"
        ALLOW_COMPUTE=0
        ;;
esac

echo "node=pixel"
echo "mode=$MODE"
echo "allow_compute=$ALLOW_COMPUTE"
echo "battery=$BATTERY"
echo "battery_temp_c=$TEMP"
echo "thermal_status=$THERMAL_STATUS"
