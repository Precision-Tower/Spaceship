CE_OS.

definition: def"
Causal Engine Operating System.
";

entrypoint: def"
Read this file first when entering ~/ce-os.

This is the minimum operational map of CE-OS.
Use it to find the next subsystem, command, or local _index.qps.
Do not duplicate knowledge that belongs deeper in the repository.
";

surface: (
Engineering- "Engineering/_index.qps";
Agency- "Agency/_index.qps";
Android- "Android/_index.qps";
UI- "UI/_index.qps";
cpp- "cpp/_index.qps";
);

qps: (
language- "Quick Parse Standard";
build- "qps build";
check- "qps path/file.qps --check";
test- "qps test path/file-or-folder";
query- "qps qry <selector> [path]";
cipher- "qps cipher <source> [--report]";
);

navigation: (
directory_separator- "/";
semantic_separator- ".";
shape- "folder/folder/file.key.term.item";
leave_file- ".folder/folder/file.key";
parent- "/folder/file.key";
two_parents- "//folder/file.key";
rule- "/ traverses filesystem scope; . traverses semantic structure inside or away from a file";
);

access: (
pixel- "ssh pixel";
repository- "cd ~/ce-os";
remote_command- "ssh pixel \"cd ~/ce-os && <command>\"";
powershell_pixel- "pixel";
powershell_command- "pixel.cmd \"command\"";
powershell_probe- "pixel.cmd \"echo PIXEL_SSH_OK && pwd\"";
powershell_ceos- "ops.cmd exec \"command\"";
powershell_script- "ops.cmd exec-file \"path-to-script.sh\"";
);

doors: (
Engineering- "Engineering/_index.qps";
door_rule- "If a directory contains _index.qps, read it before working deeper in that directory";
missing_door_rule- "If no _index.qps exists, treat the directory as a filesystem surface until a door is established";
);

rules: (
reduce_context- "_index.qps contains minimum sufficient context";
local_context_first- "Read the nearest _index.qps before widening scope";
no_repetition- "Do not duplicate information already owned by a deeper semantic surface";
preserve_work- "Do not overwrite, reset, clean, or stage unrelated unfinished work";
bounded_search- "Start with the smallest relevant directory and widen only when evidence requires it";
test_smallest_surface- "Test the smallest affected surface first";
implementation_authority- "Current implementation and passing tests outrank stale documentation";
source_location- "Use path/file.qps:ln as the canonical failure coordinate";
stage_feature_only- "Stage only files belonging to the feature being checkpointed";
);
