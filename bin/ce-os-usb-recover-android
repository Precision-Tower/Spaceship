#!/system/bin/sh

G1=${CE_OS_USB_G1:-/config/usb_gadget/g1}
G2=${CE_OS_USB_G2:-/config/usb_gadget/ceos}
UDC=${CE_OS_USB_UDC:-11110000.dwc3}
LOG=${CE_OS_USB_RECOVERY_LOG:-/data/adb/ce-os-usb-recovery.log}
MAX_ATTEMPTS=${CE_OS_USB_RECOVERY_MAX_ATTEMPTS:-12}
SLEEP_SECONDS=${CE_OS_USB_RECOVERY_SLEEP_SECONDS:-1}

log() {
    mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
    echo "$(date) $*" >> "$LOG"
}

pause() {
    sleep "$SLEEP_SECONDS"
}

read_g1_udc() {
    cat "$G1/UDC" 2>/dev/null
}

read_g2_udc() {
    cat "$G2/UDC" 2>/dev/null
}

read_hal() {
    getprop init.svc.vendor.usb-gadget-hal
}

log "recovery start"

# Freeze Android gadget management while CE-OS releases ownership.
stop vendor.usb-gadget-hal 2>/dev/null
pause

# CE-OS must release the controller first.
if [ -d "$G2" ]; then
    G2_UDC="$(read_g2_udc)"

    if [ -n "$G2_UDC" ]; then
        echo "" > "$G2/UDC" 2>>"$LOG"
        pause
    fi
fi

# Let Android's gadget HAL resume ownership of its existing g1 tree.
start vendor.usb-gadget-hal 2>/dev/null

ATTEMPT=0

while [ "$ATTEMPT" -lt "$MAX_ATTEMPTS" ]; do
    ATTEMPT=$((ATTEMPT + 1))

    HAL="$(read_hal)"
    G1_UDC="$(read_g1_udc)"
    G2_UDC="$(read_g2_udc)"

    # CE-OS must never remain bound during Android recovery.
    if [ -n "$G2_UDC" ]; then
        log "recovery attempt=$ATTEMPT releasing unexpected g2_udc=$G2_UDC"
        echo "" > "$G2/UDC" 2>>"$LOG"
        pause
        continue
    fi

    # Once the Android HAL is alive, repair a missing g1 binding.
    if [ "$HAL" = "running" ] && [ -z "$G1_UDC" ]; then
        log "recovery attempt=$ATTEMPT rebinding g1"
        echo "$UDC" > "$G1/UDC" 2>>"$LOG" || true
        pause
    else
        pause
    fi

    HAL="$(read_hal)"
    G1_UDC="$(read_g1_udc)"
    G2_UDC="$(read_g2_udc)"

    if \
        [ "$HAL" = "running" ] &&
        [ "$G1_UDC" = "$UDC" ] &&
        [ -z "$G2_UDC" ]
    then
        log "recovery complete attempt=$ATTEMPT hal=$HAL g1_udc=$G1_UDC g2_udc=<empty>"
        exit 0
    fi

    log "recovery pending attempt=$ATTEMPT hal=$HAL g1_udc=${G1_UDC:-<empty>} g2_udc=${G2_UDC:-<empty>}"
done

HAL="$(read_hal)"
G1_UDC="$(read_g1_udc)"
G2_UDC="$(read_g2_udc)"

log "recovery failed hal=$HAL g1_udc=${G1_UDC:-<empty>} g2_udc=${G2_UDC:-<empty>}"

exit 20
