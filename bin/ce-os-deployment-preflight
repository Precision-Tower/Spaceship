#!/usr/bin/env sh
set -eu

missing=0

if command -v python >/dev/null 2>&1; then
  printf 'python: %s\n' "$(command -v python)"
  python --version || missing=1
else
  printf 'python: missing\n'
  missing=1
fi

if command -v su >/dev/null 2>&1; then
  printf 'su: %s\n' "$(command -v su)"
else
  printf 'su: missing\n'
  missing=1
fi

if command -v getprop >/dev/null 2>&1; then
  printf 'getprop: %s\n' "$(command -v getprop)"
else
  printf 'getprop: missing\n'
  missing=1
fi

if command -v magisk >/dev/null 2>&1; then
  printf 'magisk: %s\n' "$(command -v magisk)"
else
  printf 'magisk: missing\n'
  missing=1
fi

exit "$missing"
