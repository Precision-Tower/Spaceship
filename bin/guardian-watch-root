#!/data/data/com.termux/files/usr/bin/bash

LOG="/data/data/com.termux/files/home/ce-os/logs/power.csv"

while true; do
    BATTERY="$(dumpsys battery)"
    THERMAL="$(dumpsys thermalservice)"

    LEVEL="$(printf '%s\n' "$BATTERY" | awk '/  level:/ {print $2; exit}')"
    AC="$(printf '%s\n' "$BATTERY" | awk '/AC powered:/ {print $3; exit}')"
    USB="$(printf '%s\n' "$BATTERY" | awk '/USB powered:/ {print $3; exit}')"
    TEMP="$(printf '%s\n' "$BATTERY" | awk '/temperature:/ {print $2; exit}')"
    THERMAL_STATUS="$(printf '%s\n' "$THERMAL" | awk '/^Thermal Status:/ {print $3; exit}')"

    if [[ "$AC" == "true" || "$USB" == "true" ]]; then
        SOURCE="external"
    else
        SOURCE="battery"
    fi

    if [[ "$SOURCE" == "battery" && "$LEVEL" -le 20 ]]; then
        MODE="SURVIVAL"
        ALLOW=0
    elif [[ "$SOURCE" == "battery" ]]; then
        MODE="MOBILE"
        ALLOW=0
    elif [[ "$THERMAL_STATUS" -le 1 ]]; then
        MODE="POWERED"
        ALLOW=1
    else
        MODE="THERMAL_SHED"
        ALLOW=0
    fi

    if [[ ! -f "$LOG" ]]; then
        echo "timestamp,mode,allow_compute,battery,battery_temp_c,thermal_status" > "$LOG"
    fi

    printf '%s,%s,%s,%s,%d.%d,%s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" \
        "$MODE" \
        "$ALLOW" \
        "$LEVEL" \
        "$((TEMP / 10))" \
        "$((TEMP % 10))" \
        "$THERMAL_STATUS" >> "$LOG"

    sleep 60
done
