#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/common.sh"
pt_initialize
pt_print_line "CE-OS shutdown"
pt_require_dashboard_root || exit 1
if [[ "${1:-}" == "--check" ]]; then
    pt_have_command systemctl && pt_status_line "PASS" "systemctl" "available for future controlled shutdown" || pt_status_line "MISSING" "systemctl" "systemctl not found"
    pt_status_line "PASS" "shutdown check" "no shutdown attempted"
    exit 0
fi
if [[ "${1:-}" != "--confirm-poweroff" ]]; then
    pt_status_line "WARNING" "shutdown refused" "This will power off the CE-OS. Re-run as: shutdown --confirm-poweroff"
    exit 2
fi
pt_have_command systemctl || { pt_status_line "MISSING" "systemctl" "cannot power off without systemctl"; exit 1; }
pt_status_line "PASS" "shutdown" "requesting controlled poweroff through systemctl"
exec systemctl poweroff