# CE-OS Node machine-local environment example.
# package/install.sh generates the real default.env during --apply.
# Do not commit the generated real file if it contains machine-specific values or secrets.

DASHBOARD_ROOT=DERIVED_BY_INSTALLER
DASHBOARD_PYTHON=DERIVED_BY_INSTALLER
AGENCY_COMMAND=UNRESOLVED
AGENCY_RUNTIME_STATUS=unresolved_no_persistent_repository_daemon
AGENCY_USER=DERIVED_BY_INSTALLER
GODOT_PATH=DERIVED_BY_INSTALLER_OR_UNRESOLVED
OPERATOR_PTY_HOST=127.0.0.1
OPERATOR_PTY_PORT=8765
HEALTH_INTERVAL_SECONDS=60
CONSOLE_REFRESH_SECONDS=10
TAILSCALE_AUTH_KEY_FILE=DERIVED_ENV_DIR/tailscale-auth.key
SSH_ADMIN_PUBLIC_KEY=UNRESOLVED
WINE_OPERATOR_PREFIX=DERIVED_USER_HOME/Applications/wine/operator