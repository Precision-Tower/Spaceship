purpose: def"
Persistent working memory for portable CE-OS provisioning and recovery work owned by package/.
";

ownership: (
surface- "package";
authority- "package/_index.qps";
);

current_work: (
tasks: (

task_1: (
identity- "package.portable_ce_os_bootstrap";
summary- "Generalize the existing Precision Tower deployment package into a portable CE-OS seed and one-flow Ubuntu LTS reconstruction path, then prove recovery without risking the Pixel control plane";
state- "active";

meaning- "CE-OS can leave the Pixel as a preserved provisioning seed, reconstruct itself on a clean Ubuntu LTS laptop, and continue development there without losing authored state or depending on undocumented machine history";

scope: (
path_1- "package";
path_2- "_index.qps";
path_3- "goals.qps";
path_4- "Android";
path_5- "qps";
);

constraints: (
item_1- "Preserve the one-root CE-OS topology; do not create a sibling or congruent CE-OS repository";
item_2- "Preserve the existing package implementation and generalize it incrementally rather than replacing proven Precision Tower behavior";
item_3- "Do not delete the Pixel checkout or treat a package copy as authority before recovery proof";
item_4- "Do not mutate Android runtime, hotspot, cellular, tethering, SSH, netd, USB gadget mode, partitions, boot state, or filesystems without a separately proven rollback-safe plan";
item_5- "Use repository-local trash/tmp for disposable CE-OS test state";
item_6- "Do not accept a complete-Ubuntu source rebuild as necessary merely for CE-OS identity; Ubuntu LTS remains the initial substrate unless evidence changes that boundary";
item_7- "Classify large datasets, models, SDKs, binaries, generated artifacts, and build trees before deciding whether they travel in the seed";
item_8- "Record provenance and cryptographic integrity for accepted external and generated bootstrap artifacts";
item_9- "Keep offline and network-required reconstruction dependencies explicit";
);

steps: (
step_1: (
goal- "Inventory the existing package, boot/bootstrap surfaces, repository size, storage, Git identity, and current Android safety state";
state- "complete";
);
step_2: (
goal- "Establish package/_index.qps and package/checklist.qps as package workflow authority";
state- "complete";
);
step_3: (
goal- "Convert Precision Tower assumptions into explicit machine-profile policy while retaining its existing tests and behavior";
state- "complete";
);
step_4: (
goal- "Define the portable seed manifest schema for source identity, required state, machine profiles, external provenance, checksums, payload classification, and Ubuntu substrate identity";
state- "complete";
);
step_5: (
goal- "Audit the full repository into required, reconstructable, optional, excluded, and machine-local payload classes";
state- "complete";
);
step_6: (
goal- "Define and implement a seed builder that writes only beneath package-owned output or trash/tmp during proof and never mutates live host state";
state- "complete";
);
step_7: (
goal- "Define and implement seed verification that proves manifest completeness and cryptographic integrity before installation";
state- "complete";
);
step_8: (
goal- "Define the Ubuntu LTS substrate contract and unattended provisioning inputs without writing boot media";
state- "complete";
);
step_9: (
goal- "Define and implement the CE-OS reconstruction entrypoint for a clean Ubuntu LTS filesystem or host with explicit dry-run and apply boundaries";
state- "complete";
);
step_10: (
goal- "Install or bootstrap QPS and CE-OS-owned native components from pinned source or accepted seed artifacts";
state- "complete";

proof- "Pinned QPS/native bootstrap authority validates exact vendored source revisions, builds QPS from qps/cpp via CMake into repository-local scratch, rejects revision drift, and passes the complete package regression suite";
);
step_11: (
goal- "Apply CE-OS configuration, services, OperatorShell or Workbench prerequisites, Agency prerequisites, and machine enrollment through authored policy";
state- "complete";

proof- "Machine enrollment authority and regression test pass; CE-OS root, Agency, Engineering, OperatorShell, Workbench, machine profile, Git identity, and service-activation boundaries are recorded without activating services or mutating Android, networking, or boot media";
);
step_12: (
goal- "Replace host-global temporary paths in package-owned tests with repository-local disposable state where this task touches them";
state- "complete";
);
step_13: (
goal- "Prove package tests, seed build and verify, reconstruction dry-run, failure integrity, exact Git identity, and single-root behavior on disposable state";
state- "waiting";
);
step_14: (
goal- "Inspect existing Android USB bootstrap implementation and design the rollback-safe phone-as-carrier or boot-device mechanism without activating it";
state- "waiting";
);
step_15: (
goal- "Only after the carrier mechanism has independent recovery guarantees, perform the minimum approved phone-side activation and prove hotspot and SSH continuity";
state- "waiting";
);
step_16: (
goal- "Produce the final Pixel preservation seed, verify all checksums, record exact Git commit and package version, and retain the original Pixel checkout";
state- "waiting";
);
step_17: (
goal- "Document clean-laptop recovery from physical connection through verified CE-OS enrollment";
state- "waiting";
);
step_18: (
goal- "Checkpoint the coherent package implementation with Git and end with a clean worktree";
state- "waiting";
);
);

proof: (
item_1- "Initial read-only inventory found package as a 216 KiB tracked Precision Tower deployment surface inside a roughly 4.7 GiB CE-OS checkout";
item_2- "Existing package explicitly reports that OS package installation, firewall mutation, service enablement, persistent Agency daemon selection, NVIDIA or CUDA installation policy, and complete deployment are unresolved";
item_3- "Root goals already define the Pixel as the first provisioning authority, clean Linux as an acceptable substrate, CE-OS reconstruction above it, independent recovery, and eventual host-to-host provisioning";
item_4- "Pixel observation at task entry reported oriole, Android 16, slot _b, verified boot state orange, flash.locked=0, with no control-plane mutation performed";
item_5- "Task-entry Git identity was bc244a13d25bb67baf5e2318c1ce9782d0ba54e7 on main with a clean worktree";
item_6- "Task-entry storage reported approximately 177 GiB available and identified several 100+ MiB datasets, Android or Godot artifacts, and build outputs requiring payload classification";
item_7- "Package-owned tests and installer scratch use repository-local trash/tmp state rather than host-global temporary storage";
item_8- "Precision hardware fixtures mock x86_64 architecture through PATH while production hardware detection remains unchanged, allowing deterministic Precision policy proof on the aarch64 Pixel";
item_9- "Package repository identity resolves from authored CE-OS root surfaces rather than removed Dashboard-era root entrypoints";
item_10- "The dashboard compatibility wrapper resolves the current UI/OperatorShell/project.godot authority when historical run-dashboard.sh is absent";
item_11- "Obsolete run.py, run-dashboard.sh, and Agency/Core/paths.py installer requirements were removed only after proving them absent and current replacement authorities present";
item_12- "Legacy launcher environment discovery now treats run-dashboard.sh as optional and deterministically falls back to package defaults under set -o pipefail";
item_13- "The complete existing Precision package contract suite passes on the Pixel after current-root, repository-local scratch, architecture-fixture, and optional-launcher corrections";
item_14- "Precision hardware policy is preserved byte-for-byte as package/config/machines/precision-tower.env while package/config/hardware.env remains the compatibility fallback";
item_15- "PT_MACHINE_PROFILE selects package-owned machine policy without changing the Precision compatibility default, and PT_HARDWARE_POLICY_FILE remains an explicit override";
item_16- "Machine-profile selection has a deterministic package test included in the complete regression suite";
item_17- "Machine-local environment generation avoids invoking absent getent on Termux while retaining HOME fallback behavior";
item_18- "package/manifests/portable-seed.qps defines source identity, Git preservation, checksum integrity, Ubuntu substrate identity, payload schema, offline boundary, reconstruction gates, and Pixel preservation requirements";
item_19- "package/manifests/payload-policy.qps defines required, reconstructable, optional, excluded, and machine_local classes with conservative preservation precedence";
item_20- "package/tools/audit_payload.py walks the repository and assigns each observed file a preservation class, inclusion decision, reason, size, and tracked-state fact";
item_21- "Every file at or above 100 MiB is emitted into a dedicated large-payload report and validated for explicit class, inclusion, and reason";
item_22- "Unknown ignored or untracked non-disposable payload defaults to optional preservation while likely host credentials and enrollment state are separated as machine_local";
item_23- "package/tools/build_seed.py creates a proof seed only beneath repository-local trash/tmp, records exact Git identity and dirty-state facts, copies seed-class payload beneath a transport payload tree, emits SHA256SUMS, and never mutates live host authority";
item_24- "Large seed-class payload may be deliberately deferred during proof construction while remaining explicitly listed in metadata/deferred.json rather than silently omitted";
item_25- "package/tools/verify_seed.py validates required seed metadata, copied-file SHA-256 values, SHA256SUMS parity, duplicate path absence, and copied-versus-deferred separation before reconstruction";
item_26- "Disposable tamper and missing-file proofs both fail verification while the untouched proof seed passes, demonstrating integrity failure detection before any installation mutation";
item_27- "package/ubuntu/_index.qps defines Ubuntu as the stable LTS substrate while retaining CE-OS ownership above that boundary and explicitly rejecting an unnecessary full-Ubuntu source rebuild";
item_28- "Tracked autoinstall inputs contain no concrete disk target, password hash, private key, or enrollment secret; identity, credentials, storage, and exact installer image remain explicit activation gates";
item_29- "The Ubuntu substrate contract is regression-tested without writing boot media, changing Android, touching partitions, or changing network state";
item_30- "package/reconstruct.sh verifies a portable seed before reconstruction, defaults to dry-run, requires explicit --apply, rejects non-empty targets, and records reconstruction identity under the reconstructed root";
item_31- "A disposable reconstruction proof demonstrates zero target mutation in dry-run, successful reconstruction from a verified seed in apply mode, and byte-preserving rejection of an occupied target";
item_32- "package/bootstrap/qps-components.qps records the observed QPS CMake build contract and exact pinned revisions for coreutils, diffutils, findutils, gawk, grep, patch, ripgrep, and sed";
item_33- "package/bootstrap/qps-bootstrap.sh verifies each vendored source revision before use and builds QPS only into repository-local reconstruction scratch";
item_34- "package/tests/test_qps_bootstrap.sh validates the bootstrap authority using the public qps file --check CLI contract, and the complete package suite remains green";
);

documentation: (
required- true;
authority- "package/_index.qps";
state- "active";
);

remaining: (
item_1- "Complete steps 2 through 18 with evidence before accepting the task";
);

next- "Portable package groundwork is verified and checkpointed; physical boot-media activation, exact Ubuntu image acceptance, and real-target provisioning remain separate future work";
);

);
);
