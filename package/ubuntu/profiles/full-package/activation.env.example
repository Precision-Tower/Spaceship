# CE-OS full-package activation inputs.
# Copy to disposable/machine-local state and resolve before rendering.
# Never commit a populated secret-bearing activation file.

CEOS_HOSTNAME=UNRESOLVED
CEOS_ADMIN_USER=UNRESOLVED
CEOS_TIMEZONE=UNRESOLVED
CEOS_PASSWORD_HASH=UNRESOLVED
CEOS_ADMIN_SSH_PUBLIC_KEY=UNRESOLVED

# Must be replaced by a reviewed Subiquity storage config for one concrete target.
CEOS_REVIEWED_STORAGE_CONFIGURATION=UNRESOLVED

# Optional. Leave disabled unless automatic Wi-Fi join is intentionally configured.
CEOS_WIFI_ENABLE=false
CEOS_WIFI_SSID=UNRESOLVED
CEOS_WIFI_PSK=UNRESOLVED

# Optional. Local/SSH installation must not depend on this.
CEOS_TAILSCALE_ENABLE=false
CEOS_TAILSCALE_AUTH_KEY=UNRESOLVED
