#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$HOME/ce-os"
OBS="$ROOT/state/ui-observation"
CONTROL="$ROOT/Android/Privileged/bin/ce-os-android-shell"

source "$ROOT/UI/OperatorShell/android/operator.env"

mkdir -p \
    "$OBS/screenshots" \
    "$OBS/logs" \
    "$OBS/ui"

STAMP="$(date '+%Y%m%d-%H%M%S')"

SCREEN="$OBS/screenshots/$STAMP.png"
LOG="$OBS/logs/$STAMP.log"
UIXML="$OBS/ui/$STAMP.xml"

LATEST_SCREEN="$OBS/latest.png"
LATEST_LOG="$OBS/latest.log"
LATEST_UI="$OBS/latest.xml"

echo "=== CLEAN OLD RUNTIME ==="
"$CONTROL" operator.force-stop || true

echo
echo "=== LOG BOUNDARY ==="
su -c "logcat -c" || true

echo
echo "=== LAUNCH ==="
"$CONTROL" operator.launch

echo
echo "=== WAIT FOR FOREGROUND ==="

foreground=""
pid=""

for _ in $(seq 1 30); do
    foreground="$("$CONTROL" operator.foreground || true)"
    pid="$("$CONTROL" operator.pid || true)"

    if [[ "$foreground" == *"$CEOS_OPERATOR_PACKAGE"* && -n "$pid" ]]; then
        break
    fi

    sleep 1
done

echo "PID=${pid:-none}"
printf '%s\n' "$foreground"

if [[ -z "$pid" ]]; then
    echo "ERROR: OperatorShell process is not running."
    exit 30
fi

if [[ "$foreground" != *"$CEOS_OPERATOR_PACKAGE"* ]]; then
    echo "ERROR: OperatorShell did not become top-resumed."
    exit 31
fi

sleep "$CEOS_OPERATOR_SETTLE_SECONDS"

echo
echo "=== SCREENSHOT ==="

"$CONTROL" operator.screenshot "$SCREEN" >/dev/null
cp "$SCREEN" "$LATEST_SCREEN"

echo
echo "=== UI HIERARCHY ==="

uiautomator dump "$UIXML" >/dev/null 2>&1 || true

if [[ -f "$UIXML" ]]; then
    cp "$UIXML" "$LATEST_UI"
else
    : > "$LATEST_UI"
fi

echo
echo "=== LOGCAT ==="

su -c "logcat -d -v threadtime" > "$LOG" || true
cp "$LOG" "$LATEST_LOG"

echo
echo "=== FINAL FOREGROUND ==="

foreground="$("$CONTROL" operator.foreground || true)"
pid="$("$CONTROL" operator.pid || true)"

echo "PID=${pid:-none}"
printf '%s\n' "$foreground"

if [[ -z "$pid" || "$foreground" != *"$CEOS_OPERATOR_PACKAGE"* ]]; then
    echo "ERROR: OperatorShell lost foreground ownership during observation."
    exit 32
fi

echo
echo "OBSERVATION COMPLETE"
echo "SCREENSHOT=$LATEST_SCREEN"
echo "UI=$LATEST_UI"
echo "LOG=$LATEST_LOG"
echo "OperatorShell remains running."
