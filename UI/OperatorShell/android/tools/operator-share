#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="/data/data/com.termux/files/home/ce-os"

if [[ $# -eq 0 ]]; then
    exec "$ROOT/qps/cpp/build-pixel/qps" screenshot
fi

SHOT="$1"
OBS="$ROOT/state/ui-observation"
URL_FILE="$OBS/latest.url"

if [[ ! -s "$SHOT" ]]; then
    echo "ERROR: screenshot missing or empty: $SHOT" >&2
    exit 1
fi

RESPONSE="$(
    curl \
        --fail \
        --silent \
        --show-error \
        -F "file=@$SHOT" \
        https://tmpfiles.org/api/v1/upload
)"

URL="$(
    printf '%s' "$RESPONSE" |
    python3 -c '
import json, sys
payload = json.load(sys.stdin)
if payload.get("status") != "success":
    raise SystemExit("upload failed")
url = payload["data"]["url"]
print(url.replace("https://tmpfiles.org/", "https://tmpfiles.org/dl/", 1))
'
)"

mkdir -p "$OBS"
printf '%s\n' "$URL" > "$URL_FILE"

echo "share=$URL"
echo "saved=$URL_FILE"
