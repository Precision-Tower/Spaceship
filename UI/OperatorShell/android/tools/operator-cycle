#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$HOME/ce-os"
TOOLS="$ROOT/UI/OperatorShell/android/tools"

cleanup_failure() {
    "$TOOLS/operator-close" >/dev/null 2>&1 || true
}

# A failed development cycle must not leave a broken runtime on screen.
# A successful cycle deliberately removes this trap so the validated
# OperatorShell remains foregrounded for visual diagnostics.
trap cleanup_failure EXIT

"$TOOLS/operator-preflight"

echo
echo "=== BUILD ==="
"$TOOLS/operator-build"

echo
echo "=== INSTALL ==="
"$TOOLS/operator-install"

echo
echo "=== OBSERVE ==="
echo "kill old -> launch new -> prove foreground -> capture -> leave visible"
"$TOOLS/operator-observe"

trap - EXIT

echo
echo "=== CYCLE COMPLETE ==="
echo "OperatorShell is validated and remains running."
