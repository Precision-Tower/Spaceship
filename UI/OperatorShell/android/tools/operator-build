#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$HOME/ce-os"
PROJECT="$ROOT/UI/OperatorShell"
ANDROID="$PROJECT/android"
ENV="$ANDROID/operator.env"
TEMPLATE="$ANDROID/template"
BUILD_ROOT="$ANDROID/build"
BUILD_TEMPLATE="$BUILD_ROOT/template"

CEOS="$ROOT/Android/Termux/bin/ce-os"
SDK_ROOT="$ROOT/Android/SDK"

source "$ENV"

safe_rm_dir() {
    local target="$1"
    local allowed_parent="$2"

    case "$target" in
        "$allowed_parent"/*)
            rm -rf "$target"
            ;;
        *)
            echo "ERROR: refusing recursive delete outside $allowed_parent:"
            echo "  $target"
            exit 30
            ;;
    esac
}

cleanup() {
    :
}

trap cleanup EXIT

check_compute_allowed() {
    local label="${1:-}"

    echo "=== CE-OS STATUS${label:+ ($label)} ==="
    local status
    status="$("$CEOS" --json status)"
    printf '%s\n' "$status"

    local allow
    allow="$(
        printf '%s\n' "$status" |
        python3 -c 'import json,sys; print(json.load(sys.stdin)["state"]["allow_compute"])'
    )"

    if [[ "$allow" != "1" ]]; then
        echo "ERROR: CE-OS compute is not currently allowed."
        exit 20
    fi
}

first_installed_build_tools() {
    find "$SDK_ROOT/build-tools" -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
        sort |
        tail -n 1
}

read_preset_value() {
    local key="$1"
    local fallback="$2"
    local value

    value="$(awk -F= -v key="$key" '$1 == key {gsub(/^"|"$/, "", $2); print $2; exit}' "$PROJECT/export_presets.cfg")"
    if [[ -z "$value" ]]; then
        printf '%s\n' "$fallback"
    else
        printf '%s\n' "$value"
    fi
}


patch_generated_template() {
    local manifest="$BUILD_TEMPLATE/src/main/AndroidManifest.xml"
    local config_gradle="$BUILD_TEMPLATE/config.gradle"
    local build_gradle="$BUILD_TEMPLATE/build.gradle"
    local build_tools_dir
    local build_tools_version

    build_tools_dir="$(first_installed_build_tools)"
    if [[ -z "$build_tools_dir" ]]; then
        echo "ERROR: no Android SDK build-tools directory found under $SDK_ROOT"
        exit 31
    fi
    build_tools_version="$(basename "$build_tools_dir")"

    sed -i 's/android:screenOrientation="landscape"/android:screenOrientation="portrait"/' "$manifest"
    if ! grep -q 'android:screenOrientation="portrait"' "$manifest"; then
        echo "ERROR: generated AndroidManifest.xml was not patched to portrait."
        exit 32
    fi

    sed -i "s/buildTools         : '[^']*'/buildTools         : '$build_tools_version'/" "$config_gradle"

    if [[ ! -d "$SDK_ROOT/ndk" ]]; then
        sed -i '/^[[:space:]]*ndkVersion versions\.ndkVersion[[:space:]]*$/d' "$build_gradle"
    fi

}

echo "=== VALIDATE PROJECT ==="

test -f "$PROJECT/project.godot"
test -f "$PROJECT/export_presets.cfg"
test -f "$PROJECT/scenes/Main.tscn"
test -f "$PROJECT/_index.qps"
test -f "$TEMPLATE/gradlew"
test -f "$TEMPLATE/build.gradle"
test -f "$TEMPLATE/config.gradle"
test -f "$TEMPLATE/src/main/AndroidManifest.xml"
test -f "$TEMPLATE/src/main/java/com/godot/game/GodotApp.java"
test -d "$SDK_ROOT/platforms/android-36"

preset_package="$(read_preset_value "package/unique_name" "$CEOS_OPERATOR_PACKAGE")"
if [[ "$preset_package" != "$CEOS_OPERATOR_PACKAGE" ]]; then
    echo "ERROR: export preset package ($preset_package) does not match operator.env ($CEOS_OPERATOR_PACKAGE)."
    exit 33
fi

version_code="$(read_preset_value "version/code" "1")"
version_name="$(read_preset_value "version/name" "0.1.0")"

echo "project: OK"
echo "package: $CEOS_OPERATOR_PACKAGE"
echo "version: $version_name ($version_code)"

check_compute_allowed "before Android packaging"

echo
echo "=== DIRECT GODOT PROJECT ASSETS ==="

echo "Current OperatorShell source will be packaged directly into APK assets."

check_compute_allowed "before APK packaging"

echo
echo "=== PREPARE ANDROID TEMPLATE ==="

if [[ "${CEOS_OPERATOR_CLEAN_BUILD:-0}" == "1" ]]; then
    echo "Clean build requested."
    safe_rm_dir "$BUILD_TEMPLATE" "$BUILD_ROOT"
fi

# Keep the generated Gradle workspace persistent across normal development
# cycles so .gradle and build/ can retain incremental state.
if [[ ! -f "$BUILD_TEMPLATE/gradlew" ]]; then
    echo "Initializing persistent Android build workspace."
    mkdir -p "$BUILD_ROOT"
    cp -a "$TEMPLATE" "$BUILD_TEMPLATE"
else
    echo "Reusing persistent Android build workspace."
fi

chmod +x "$BUILD_TEMPLATE/gradlew"

# Synchronize template inputs while preserving BUILD_TEMPLATE/.gradle and
# BUILD_TEMPLATE/build.
(
    cd "$TEMPLATE"
    tar \
        --exclude='./.gradle' \
        --exclude='./build' \
        -cf - .
) | (
    cd "$BUILD_TEMPLATE"
    tar -xf -
)

# Assets are generated input. Replace only this subtree so deleted or renamed
# OperatorShell files cannot survive into a later APK.
safe_rm_dir "$BUILD_TEMPLATE/src/main/assets" "$BUILD_TEMPLATE/src/main"
mkdir -p "$BUILD_TEMPLATE/src/main/assets"

# Godot Android library mode can load project files directly from APK assets.
(
    cd "$PROJECT"
    tar \
        --exclude='./android' \
        --exclude='./.git' \
        -cf - .
) | (
    cd "$BUILD_TEMPLATE/src/main/assets"
    tar -xf -
)

test -f "$BUILD_TEMPLATE/src/main/assets/project.godot"
test -f "$BUILD_TEMPLATE/src/main/assets/scenes/Main.tscn"
test -f "$BUILD_TEMPLATE/src/main/assets/_index.qps"

printf 'sdk.dir=%s\n' "$SDK_ROOT" > "$BUILD_TEMPLATE/local.properties"

patch_generated_template

echo "template: $BUILD_TEMPLATE"
echo "assets: current OperatorShell project"

echo
echo "=== GRADLE APK BUILD ==="

export ANDROID_HOME="$SDK_ROOT"
export ANDROID_SDK_ROOT="$SDK_ROOT"
export JAVA_HOME="${JAVA_HOME:-${PREFIX:-/data/data/com.termux/files/usr}/lib/jvm/java-17-openjdk}"
export PATH="$JAVA_HOME/bin:$PATH"

(
    cd "$BUILD_TEMPLATE"
    ./gradlew --no-daemon --stacktrace assembleStandardDebug \
        "-Pexport_package_name=$CEOS_OPERATOR_PACKAGE" \
        "-Pexport_version_code=$version_code" \
        "-Pexport_version_name=$version_name" \
        "-Pexport_version_min_sdk=24" \
        "-Pexport_version_target_sdk=36" \
        "-Pexport_enabled_abis=arm64-v8a|" \
        "-Pperform_signing=true" \
        "-Pperform_zipalign=true" \
        "-Pcompress_native_libraries=true"
)

built_apk="$BUILD_TEMPLATE/build/outputs/apk/standard/debug/android_debug.apk"
if [[ ! -s "$built_apk" ]]; then
    echo "ERROR: Gradle did not produce expected APK:"
    echo "  $built_apk"
    exit 22
fi

cp "$built_apk" "$CEOS_OPERATOR_APK"

echo
echo "=== APK VERIFY ==="

ls -lh "$CEOS_OPERATOR_APK"
apksigner verify --print-certs "$CEOS_OPERATOR_APK"
aapt2 dump packagename "$CEOS_OPERATOR_APK"
aapt2 dump badging "$CEOS_OPERATOR_APK" |
    grep -E "package:|launchable-activity|uses-feature: name='android.hardware.screen" || true

if ! aapt2 dump permissions "$CEOS_OPERATOR_APK" |
    grep -q 'android.permission.INTERNET'
then
    echo "ERROR: OperatorShell APK is missing android.permission.INTERNET"
    exit 34
fi

echo "permission INTERNET: OK"

echo
echo "OPERATORSHELL APK READY"
echo "APK=$CEOS_OPERATOR_APK"
