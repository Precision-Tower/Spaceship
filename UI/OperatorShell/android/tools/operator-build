#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$HOME/ce-os"
PROJECT="$ROOT/UI/OperatorShell"
ANDROID="$PROJECT/android"
ENV="$ANDROID/operator.env"
TEMPLATE="$ANDROID/template"
BUILD_ROOT="$ANDROID/build"
BUILD_TEMPLATE="$BUILD_ROOT/template"
STAGING="/sdcard/CE-OS/OperatorShell"
SDCARD_PCK="/sdcard/CE-OS/operatorshell.pck"
BUILD_PCK="$BUILD_ROOT/operatorshell.pck"

CEOS="$ROOT/Android/Termux/bin/ce-os"
GODOT_PACKAGE="org.godotengine.editor.v4"
GODOT_ACTIVITY="org.godotengine.editor.GodotEditor"
SDK_ROOT="$ROOT/Android/SDK"

source "$ENV"

ROTATION_ACCELEROMETER=""
ROTATION_USER=""
ROTATION_LOCKED=0

safe_rm_dir() {
    local target="$1"
    local allowed_parent="$2"

    case "$target" in
        "$allowed_parent"/*)
            rm -rf "$target"
            ;;
        *)
            echo "ERROR: refusing recursive delete outside $allowed_parent:"
            echo "  $target"
            exit 30
            ;;
    esac
}

read_system_setting() {
    local namespace="$1"
    local key="$2"

    su -c "settings get '$namespace' '$key'" 2>/dev/null | tr -d '\r' || true
}

write_system_setting() {
    local namespace="$1"
    local key="$2"
    local value="$3"

    if [[ -n "$value" && "$value" != "null" ]]; then
        su -c "settings put '$namespace' '$key' '$value'" || true
    fi
}

lock_editor_rotation() {
    if [[ "$ROTATION_LOCKED" == "1" ]]; then
        return
    fi

    ROTATION_ACCELEROMETER="$(read_system_setting system accelerometer_rotation)"
    ROTATION_USER="$(read_system_setting system user_rotation)"

    su -c "settings put system accelerometer_rotation 0" || true
    su -c "settings put system user_rotation 1" || true
    ROTATION_LOCKED=1
    sleep 1
}

restore_editor_rotation() {
    if [[ "$ROTATION_LOCKED" != "1" ]]; then
        return
    fi

    write_system_setting system user_rotation "$ROTATION_USER"
    write_system_setting system accelerometer_rotation "$ROTATION_ACCELEROMETER"
    ROTATION_LOCKED=0
}

cleanup() {
    restore_editor_rotation
    su -c "am force-stop '$GODOT_PACKAGE'" || true
}

trap cleanup EXIT

check_compute_allowed() {
    local label="${1:-}"

    echo "=== CE-OS STATUS${label:+ ($label)} ==="
    local status
    status="$("$CEOS" --json status)"
    printf '%s\n' "$status"

    local allow
    allow="$(
        printf '%s\n' "$status" |
        python3 -c 'import json,sys; print(json.load(sys.stdin)["state"]["allow_compute"])'
    )"

    if [[ "$allow" != "1" ]]; then
        echo "ERROR: CE-OS compute is not currently allowed."
        exit 20
    fi
}

first_installed_build_tools() {
    find "$SDK_ROOT/build-tools" -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
        sort |
        tail -n 1
}

read_preset_value() {
    local key="$1"
    local fallback="$2"
    local value

    value="$(awk -F= -v key="$key" '$1 == key {gsub(/^"|"$/, "", $2); print $2; exit}' "$PROJECT/export_presets.cfg")"
    if [[ -z "$value" ]]; then
        printf '%s\n' "$fallback"
    else
        printf '%s\n' "$value"
    fi
}

runtime_source_newer_than() {
    local pack="$1"

    find "$PROJECT" \
        \( -path "$PROJECT/android" -o -path "$PROJECT/.godot" \) -prune -o \
        -type f \
        \( -name '*.gd' -o -name '*.tscn' -o -name '*.tres' -o -name 'project.godot' -o -name '_index.qps' \) \
        -newer "$pack" \
        -print \
        -quit
}

patch_generated_template() {
    local manifest="$BUILD_TEMPLATE/src/main/AndroidManifest.xml"
    local app_java="$BUILD_TEMPLATE/src/main/java/com/godot/game/GodotApp.java"
    local config_gradle="$BUILD_TEMPLATE/config.gradle"
    local build_gradle="$BUILD_TEMPLATE/build.gradle"
    local build_tools_dir
    local build_tools_version

    build_tools_dir="$(first_installed_build_tools)"
    if [[ -z "$build_tools_dir" ]]; then
        echo "ERROR: no Android SDK build-tools directory found under $SDK_ROOT"
        exit 31
    fi
    build_tools_version="$(basename "$build_tools_dir")"

    sed -i 's/android:screenOrientation="landscape"/android:screenOrientation="portrait"/' "$manifest"
    if ! grep -q 'android:screenOrientation="portrait"' "$manifest"; then
        echo "ERROR: generated AndroidManifest.xml was not patched to portrait."
        exit 32
    fi

    sed -i "s/buildTools         : '[^']*'/buildTools         : '$build_tools_version'/" "$config_gradle"

    if [[ ! -d "$SDK_ROOT/ndk" ]]; then
        sed -i '/^[[:space:]]*ndkVersion versions\.ndkVersion[[:space:]]*$/d' "$build_gradle"
    fi

    python3 - "$app_java" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text()

if "operatorshell.pck" not in text:
    text = text.replace(
        "import android.util.Log;\n\n",
        "import android.util.Log;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\n",
    )
    marker = "\t@Override\n\tpublic void onCreate(Bundle savedInstanceState) {\n"
    method = (
        "\t@Override\n"
        "\tpublic List<String> getCommandLine() {\n"
        "\t\tList<String> commandLine = new ArrayList<>(super.getCommandLine());\n"
        "\t\tcommandLine.add(\"--main-pack\");\n"
        "\t\tcommandLine.add(\"res://operatorshell.pck\");\n"
        "\t\treturn commandLine;\n"
        "\t}\n\n"
    )
    if marker not in text:
        raise SystemExit("GodotApp.java onCreate marker not found")
    text = text.replace(marker, method + marker)

path.write_text(text)
PY
}

echo "=== VALIDATE PROJECT ==="

test -f "$PROJECT/project.godot"
test -f "$PROJECT/export_presets.cfg"
test -f "$PROJECT/scenes/Main.tscn"
test -f "$PROJECT/_index.qps"
test -f "$TEMPLATE/gradlew"
test -f "$TEMPLATE/build.gradle"
test -f "$TEMPLATE/config.gradle"
test -f "$TEMPLATE/src/main/AndroidManifest.xml"
test -f "$TEMPLATE/src/main/java/com/godot/game/GodotApp.java"
test -d "$SDK_ROOT/platforms/android-36"

preset_package="$(read_preset_value "package/unique_name" "$CEOS_OPERATOR_PACKAGE")"
if [[ "$preset_package" != "$CEOS_OPERATOR_PACKAGE" ]]; then
    echo "ERROR: export preset package ($preset_package) does not match operator.env ($CEOS_OPERATOR_PACKAGE)."
    exit 33
fi

version_code="$(read_preset_value "version/code" "1")"
version_name="$(read_preset_value "version/name" "0.1.0")"

echo "project: OK"
echo "package: $CEOS_OPERATOR_PACKAGE"
echo "version: $version_name ($version_code)"

check_compute_allowed "before export-pack"

echo
echo "=== SYNC GODOT STAGING ==="

mkdir -p "$(dirname "$STAGING")"
safe_rm_dir "$STAGING" "/sdcard/CE-OS"
cp -a "$PROJECT" "$STAGING"

rm -f "$SDCARD_PCK"
mkdir -p "$BUILD_ROOT"
rm -f "$BUILD_PCK" "$CEOS_OPERATOR_APK"

echo
echo "=== GODOT EXPORT PACK ==="

su -c "am force-stop '$GODOT_PACKAGE'" || true
su -c "logcat -c" || true
lock_editor_rotation

su -c "am start --user 0 -W \
  -n '$GODOT_PACKAGE/$GODOT_ACTIVITY' \
  --esa command_line_params \
  '--headless,--path,$STAGING,--export-pack,Android,$SDCARD_PCK'"

echo
echo "=== WAIT FOR PCK ==="

for _ in $(seq 1 120); do
    if [[ -s "$SDCARD_PCK" ]]; then
        echo "PCK CREATED"
        ls -lh "$SDCARD_PCK"
        break
    fi

    sleep 1
done

pck_source="$SDCARD_PCK"

if [[ ! -s "$SDCARD_PCK" ]]; then
    echo "ERROR: Godot did not produce a PCK."

    su -c "logcat -d -v brief" |
    grep -Ei 'godot|export|savepack|error|failed' |
    tail -120 || true

    fallback_pck="${CEOS_OPERATOR_FALLBACK_PCK:-/sdcard/CE-OS/operatorshell-test.pck}"
    newer_source=""
    if [[ -s "$fallback_pck" ]]; then
        newer_source="$(runtime_source_newer_than "$fallback_pck")"
    fi

    if [[ -s "$fallback_pck" && -z "$newer_source" ]]; then
        echo
        echo "WARNING: live export-pack failed; reusing source-current fallback PCK."
        echo "FALLBACK_PCK=$fallback_pck"
        pck_source="$fallback_pck"
    else
        if [[ -n "$newer_source" ]]; then
            echo "ERROR: fallback PCK is stale; newer runtime source exists:"
            echo "  $newer_source"
        fi
        su -c "am force-stop '$GODOT_PACKAGE'" || true
        exit 21
    fi
fi

echo
echo "=== EXPORT LOG ==="

su -c "logcat -d -v brief" |
grep -Ei 'savepack|export.*(complete|failed)|error.*export|failed.*export' |
tail -80 || true

su -c "am force-stop '$GODOT_PACKAGE'" || true
restore_editor_rotation

cp "$pck_source" "$BUILD_PCK"

check_compute_allowed "before APK packaging"

echo
echo "=== PREPARE ANDROID TEMPLATE ==="

safe_rm_dir "$BUILD_TEMPLATE" "$BUILD_ROOT"
cp -a "$TEMPLATE" "$BUILD_TEMPLATE"
chmod +x "$BUILD_TEMPLATE/gradlew"

mkdir -p "$BUILD_TEMPLATE/src/main/assets"
cp "$BUILD_PCK" "$BUILD_TEMPLATE/src/main/assets/operatorshell.pck"
printf 'sdk.dir=%s\n' "$SDK_ROOT" > "$BUILD_TEMPLATE/local.properties"

patch_generated_template

echo "template: $BUILD_TEMPLATE"
echo "asset: src/main/assets/operatorshell.pck"

echo
echo "=== GRADLE APK BUILD ==="

export ANDROID_HOME="$SDK_ROOT"
export ANDROID_SDK_ROOT="$SDK_ROOT"
export JAVA_HOME="${JAVA_HOME:-${PREFIX:-/data/data/com.termux/files/usr}/lib/jvm/java-17-openjdk}"
export PATH="$JAVA_HOME/bin:$PATH"

(
    cd "$BUILD_TEMPLATE"
    ./gradlew --no-daemon --stacktrace assembleStandardDebug \
        "-Pexport_package_name=$CEOS_OPERATOR_PACKAGE" \
        "-Pexport_version_code=$version_code" \
        "-Pexport_version_name=$version_name" \
        "-Pexport_version_min_sdk=24" \
        "-Pexport_version_target_sdk=36" \
        "-Pexport_enabled_abis=arm64-v8a|" \
        "-Pperform_signing=true" \
        "-Pperform_zipalign=true" \
        "-Pcompress_native_libraries=true"
)

built_apk="$BUILD_TEMPLATE/build/outputs/apk/standard/debug/android_debug.apk"
if [[ ! -s "$built_apk" ]]; then
    echo "ERROR: Gradle did not produce expected APK:"
    echo "  $built_apk"
    exit 22
fi

cp "$built_apk" "$CEOS_OPERATOR_APK"

echo
echo "=== APK VERIFY ==="

ls -lh "$CEOS_OPERATOR_APK"
apksigner verify --print-certs "$CEOS_OPERATOR_APK"
aapt2 dump packagename "$CEOS_OPERATOR_APK"
aapt2 dump badging "$CEOS_OPERATOR_APK" |
    grep -E "package:|launchable-activity|uses-feature: name='android.hardware.screen" || true

echo
echo "OPERATORSHELL APK READY"
echo "APK=$CEOS_OPERATOR_APK"
echo "PCK=$BUILD_PCK"
