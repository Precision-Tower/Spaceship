interfaces.
Engineering: (
relation- "Workbench consumes Engineering outputs and authors explicit candidate intent";
boundary- "Engineering may reject modify or replace Workbench intent";
);
UI: (
relation- "Workbench is an engineering workspace within the CE-OS Godot UI";
boundary- "final project boot and routing relationship remains unresolved";
);
OperatorShell: (
relation- "separate operator command and system workspace";
boundary- "final navigation relationship remains unresolved";
);
Agency: (
relation- "may automate bounded Workbench and Engineering workflows";
boundary- "Agency execution does not become Engineering truth";
);

authority.
Engineering- "engineering meaning calculation model geometry and validation state";
Workbench- "operator interaction workspace visualization and explicit intent";
Godot- "viewport interaction and UI rendering";
OperatorShell- "system command and development operations";
Agency- "bounded automation";
apparatus- "physical measurement";

invariants.
whitebox- "Engineering state remains inspectable";
rendering- "visual output is not evidence by itself";
ghosts- "candidate intent remains distinguishable from Engineering objects";
definitions- "Design Definitions remain distinct from Design Instances";
semantic_identity- "selection resolves to stable Engineering meaning rather than raw mesh identity";
failures- "failed builds do not silently replace last known valid geometry";
unknowns- "unresolved parameters remain visible";
ports- "ports represent Engineering interfaces";
graphs- "assembly spatial and functional relationships remain distinct";

