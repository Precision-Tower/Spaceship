#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import shutil
import struct
import subprocess
import sys
from datetime import datetime
from pathlib import Path


def fail(message: str, code: int = 1) -> int:
    print("SCREENSHOT=FAIL", file=sys.stderr)
    print(f"error={message}", file=sys.stderr)
    return code


def png_dimensions(path: Path) -> tuple[int, int]:
    with path.open("rb") as handle:
        header = handle.read(24)
    if len(header) < 24 or header[:8] != b"\x89PNG\r\n\x1a\n" or header[12:16] != b"IHDR":
        raise ValueError("capture is not a valid PNG")
    width, height = struct.unpack(">II", header[16:24])
    if width <= 0 or height <= 0:
        raise ValueError("capture has invalid dimensions")
    return width, height


def main(argv: list[str]) -> int:
    if len(argv) != 0:
        return fail("usage: qps screenshot", 2)

    root = Path(os.environ.get("CEOS_ROOT", Path(__file__).resolve().parents[2])).resolve()
    trash = root / "trash" / "tmp"
    control_override = os.environ.get("QPS_SCREENSHOT_CONTROL")
    control = Path(control_override) if control_override else None
    upload_url = os.environ.get(
        "QPS_SCREENSHOT_UPLOAD_URL",
        "https://catbox.moe/user/api.php",
    )
    curl = os.environ.get("QPS_SCREENSHOT_CURL", "curl")

    trash.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    shot = trash / f"qps-screenshot-{stamp}.png"

    try:
        if control is not None:
            capture_command = [str(control), "operator.screenshot", str(shot)]
        elif Path("/system/bin/screencap").is_file():
            capture_command = [
                str(root / "Android" / "Privileged" / "bin" / "ce-os-android-shell"),
                "operator.screenshot",
                str(shot),
            ]
        else:
            display = os.environ.get("DISPLAY", ":0")
            capture_command = [
                "import",
                "-display",
                display,
                "-window",
                "root",
                str(shot),
            ]

        capture = subprocess.run(
            capture_command,
            cwd=root,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if capture.returncode != 0:
            detail = capture.stderr.strip() or capture.stdout.strip() or f"exit {capture.returncode}"
            return fail(f"capture failed: {detail}")

        if not shot.is_file() or shot.stat().st_size <= 0:
            return fail("capture did not produce a non-empty PNG")

        try:
            width, height = png_dimensions(shot)
        except ValueError as exc:
            return fail(str(exc))

        upload = subprocess.run(
            [
                curl,
                "--fail",
                "--silent",
                "--show-error",
                "-F",
                "reqtype=fileupload",
                "-F",
                f"fileToUpload=@{shot}",
                upload_url,
            ],
            cwd=root,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if upload.returncode != 0:
            detail = upload.stderr.strip() or f"exit {upload.returncode}"
            return fail(f"publication failed: {detail}")

        url = upload.stdout.strip()
        if not url.startswith("https://files.catbox.moe/"):
            return fail("publication response invalid: upload service returned no direct HTTPS file URL")

        print("SCREENSHOT=PASS")
        print(f"path={shot.relative_to(root).as_posix()}")
        print(f"url={url}")
        print(f"width={width}")
        print(f"height={height}")
        print("exposure=temporary-public-https")
        return 0
    finally:
        try:
            shot.unlink(missing_ok=True)
        except OSError:
            pass


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
