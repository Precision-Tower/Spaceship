task_3: (
identity- "bin.semantic_search_policy";
summary- "Unify probe, scope, and scout around repository-aware QPS discovery policy";
state- "complete";

product- "QPS semantic search tools share one definition of current-source evidence while remaining free to use rg, grep, sed, parser traversal, or future mechanisms underneath";

current: (
item_1- "History is one global root ledger and may become very large";
item_2- "Historical identifiers and paths must not pollute ordinary current-source discovery";
item_3- "probe, scope, and scout already represent distinct operator-facing QPS search concepts";
item_4- "Root _index.qps authors discovery_policy.excluded_documents and generic document-role semantics for current-source discovery";
item_5- "scout reads discovery_policy.excluded_documents structurally from the selected module _index.qps before matching immediate QPS documents";
item_6- "The scout implementation contains no History filename heuristic; arbitrary documents such as archive.qps can be excluded through authored policy";
item_7- "A QPS Key paragraph ends at its own blank-line boundary, so module-level discovery_policy is authored as a peer structural Term";
item_8- "probe and scope remain explicit-document evidence tools and can inspect documents excluded from broad scout discovery";
item_9- "qps history remains the dedicated historical query interface";
item_10- "PathResolver::qpsFiles remains a generic immediate-document primitive while semantic corpus policy is owned at the scout command boundary";
item_11- "Focused witnesses prove root History exclusion, generic authored exclusion, preserved current-source discovery, explicit historical access, and unchanged PathResolver behavior";
);

steps: (

step_1: (
goal- "Define generic document roles or discovery policy in authored repository authority";
product- "Documents such as ledgers, generated material, or archives can be excluded from ordinary semantic discovery without hard-coding filenames into search engines";
state- "complete";
);

step_2: (
goal- "Make scout honor the shared discovery policy";
product- "scout searches current authored evidence without returning stale History matches by default";
state- "complete";
);

step_3: (
goal- "Decide how probe and scope interact with explicitly addressed excluded documents";
product- "Direct evidence inspection remains possible even when a document is excluded from broad discovery";
state- "complete";
);

step_4: (
goal- "Decide whether qps/bin search commands wrap stock utilities, patched utilities, or native parser traversal per operation";
product- "Implementation mechanism can evolve without changing operator-facing command semantics";
state- "complete";
);

);

