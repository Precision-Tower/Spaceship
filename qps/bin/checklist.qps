CHECKLIST.

current_work: (
tasks: (

task_1: (
identity- "bin.change_value";
summary- "Implement cv as the first QPS-aware terminal mutation command";
state- "complete";

product- "From any CE-OS terminal location, a user can run cv <structural-path/item-> <new-value> to change exactly one authored QPS Item while preserving relative working-directory context and structural validity";

current: (
item_1- "The intended command surface is cv <path/item-> <newValue>";
item_2- "The command should operate on QPS structure rather than textual grep-and-replace";
item_3- "Python is the preferred initial command implementation language";
item_4- "Candidate QPS must validate before the source file is replaced";
);

documentation: (
required- true;
authority- "qps/bin/_index.qps";
goal- "Document the proven cv command contract, path resolution behavior, validation boundary, and publication behavior";
state- "complete";
);

steps: (

step_1: (
goal- "Define cv path resolution from the terminal current working directory";
product- "A structural target can be resolved relative to the operator's current CE-OS location without rebasing every command to repository root";
state- "complete";
);

step_2: (
goal- "Resolve the requested QPS Item structurally and identify the exact value/source ownership that may be replaced";
product- "cv changes the selected Item only and does not accidentally mutate matching text elsewhere";
state- "complete";
);

step_3: (
goal- "Construct a complete candidate QPS document containing the new Item value";
product- "Mutation happens against candidate bytes rather than directly editing authoritative source";
state- "complete";
);

step_4: (
goal- "Validate the candidate with QPS parsing before publication";
product- "Malformed replacement values cannot corrupt the authored QPS file";
state- "complete";
);

step_5: (
goal- "Publish the validated candidate atomically and return concise terminal evidence";
product- "cv either completes one valid structural value change or leaves the original file unchanged";
state- "complete";
);

step_6: (
goal- "Prove scalar string, numeric, boolean, reference, and expression-valued Items as supported cases or explicitly document unsupported cases";
product- "The command contract is based on proven QPS value semantics rather than assumptions";
state- "complete";
);

);

findings: (
finding_1- "The terminal mutation layer should preserve familiar command simplicity while using QPS structure underneath";
finding_2- "cv should be a structural editor, not a shorthand wrapper around sed substitution";
finding_3- "The current working directory is useful semantic context and should normally be inherited rather than discarded";
finding_4- "cv now resolves a target as an extensionless or .qps file path plus a document-local structural Item path from the terminal current working directory";
finding_5- "cv delegates Item resolution to qps scope, so the replacement span comes from QPS structural selection rather than textual matching";
finding_6- "cv writes a complete candidate document, validates it with qps --check, and publishes through os.replace only after validation succeeds";
finding_7- "The proof covers string, numeric, boolean, reference, and expression-valued Items plus invalid replacement rollback and same-name sibling preservation";
);

observed_evidence: (
file_1- "qps/bin/cv";
file_2- "qps/bin/tests/cv_test.py";
file_3- "qps/bin/_index.qps";
test_1- "python3 qps/bin/tests/cv_test.py qps/bin/cv => qps/bin cv: PASS";
check_1- "qps qps/bin/_index.qps --check => PASS";
check_2- "qps qps/bin/checklist.qps --check => PASS";
);

next- "Ready for qps save 3 1 once the user chooses to accept this completed task into History";

done_when: (
condition_1- "cv can change one structurally identified Item from the terminal";
condition_2- "The command preserves relative current-directory behavior";
condition_3- "Invalid replacement values produce no source mutation";
condition_4- "Successful replacement changes only the selected Item";
condition_5- "qps/bin/_index.qps documents the proven command behavior";
);
);


task_2: (
identity- "bin.inline_qps_terminal";
summary- "Implement QPS Inline as the compact terminal source surface [< code]";
state- "complete";

product- "A user or agent can execute transient QPS directly from the terminal using one syntax, [< code], with the terminal current working directory preserved as execution context";

syntax: (
name- "QPS Inline";
surface- "[< code]";
open- "[<";
close- "]";
content- "Everything between [< and the matching ] is transient QPS source";
single_and_multiline- "Single-line and multiline input are the same construct; multiline is not a separate syntax";
no_alternate_close- "There is no >] or [<>] form";
);

examples: (
single_line- "[< cv config.mode- \"active\";]";
multiline- "[< newline cv config.mode- \"active\"; newline cv config.timeout- 30; newline ]";
);

execution_model: (
source- "The enclosed content is parsed as transient QPS rather than requiring a permanent .qps file";
working_directory- "Execution inherits the terminal current working directory";
relative_paths- "Relative paths and imports resolve from the inherited terminal context unless authored QPS explicitly changes context";
stdout- "QPS stdout remains terminal stdout";
stderr- "QPS errors remain terminal stderr";
status- "QPS execution status propagates back to the terminal";
);

current: (
item_1- "Bash/Python heredoc syntax such as python3 - <<'PY' is functional but unnecessarily verbose for CE-OS terminal work";
item_2- "The desired QPS-facing replacement is one bracketed source form: [< code]";
item_3- "The same construct must accept both one-line and multiline source without alternate grammar";
item_4- "qps/bin is the intended implementation area for the terminal bridge";
item_5- "OperatorShell multiline terminal input is now an explicit dependency: Shift+Enter must insert a newline without submitting before QPS Inline multiline interaction is considered nominal";
);

documentation: (
required- true;
authority- "qps/bin/_index.qps";
goal- "Document the proven QPS Inline syntax, execution context, source boundary, and terminal behavior";
state- "complete";
);

steps: (

step_1: (
goal- "Implement a terminal bridge that recognizes [< code] and forwards the enclosed bytes as transient QPS source";
product- "Inline QPS can execute without creating a permanent source file";
state- "complete";
);

step_2: (
goal- "Use the same parser/execution path for single-line and multiline QPS Inline input";
product- "There is one syntax and one runtime contract regardless of source length";
state- "complete";
);

step_3: (
goal- "Preserve terminal current-working-directory context during transient execution";
product- "Relative QPS paths and imports behave naturally from the operator's present repository location";
state- "complete";
);

step_4: (
goal- "Define matching-bracket, quoting, nested-container, and literal-bracket behavior sufficiently for real QPS source";
product- "The terminal can determine where [< code] ends without corrupting valid QPS syntax";
state- "complete";
);

step_5: (
goal- "Prove stdout, stderr, exit status, parse failure, and runtime failure behavior";
product- "QPS Inline behaves predictably enough for humans, scripts, and agents";
state- "complete";
);

step_6: (
goal- "Use QPS Inline to perform a real repository operation such as cv against a disposable QPS document";
product- "The inline surface is proven as useful execution infrastructure rather than syntax-only sugar";
state- "complete";
);

);

findings: (
finding_1- "The brackets themselves define the source boundary: [< begins QPS Inline and ] closes it";
finding_2- "The less-than symbol means source is entering QPS execution; no second closing operator is needed";
finding_3- "Multiline input is the general case and single-line input is simply a multiline-capable block containing one line";
finding_4- "QPS Inline should replace verbose shell heredoc ceremony for transient QPS operations while preserving ordinary terminal context";
finding_5- "qps/bin/inline and inline_lib.py implement one extraction/execution path for both single-line and multiline QPS Inline";
finding_6- "The bridge closes on the first unmatched ] outside quoted strings, nested square containers, parentheses, and braces";
finding_7- "Transient QPS executes from the terminal current working directory and its temporary source is removed on success and failure";
finding_8- "QPS stdout, parser/runtime stderr, parse status, and runtime failure status propagate through the inline command";
finding_9- "qps/bin/terminal.bash composes a private readline hook with Ctrl+J accept-line so ordinary Bash input survives while [< source] is intercepted before Bash parses it";
finding_10- "Agency/Core/runtime/terminal/pty_service.py now starts Bash with qps/bin/terminal.bash as the interactive rcfile";
finding_11- "Real PTY witnesses prove ordinary Enter, Shift+Enter multiline QPS Inline, no Bash syntax interpretation of inline source, post-inline commands, and readline history";
finding_12- "A disposable QPS document was successfully changed through transient QPS by invoking qps/bin/cv from QPS Inline";

);

next- "QPS Inline is proven complete; continue with the next authored qps/bin checklist task";

done_when: (
condition_1- "[< code] is the only canonical QPS Inline syntax";
condition_2- "One-line and multiline source use the same parser and execution path";
condition_3- "The enclosed source executes as transient QPS";
condition_4- "Terminal working-directory context is preserved";
condition_5- "Errors and exit status propagate predictably";
condition_6- "qps/bin/_index.qps documents the proven interface";
);
