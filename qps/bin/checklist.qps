state- "active";
);

step_3: (
goal- "Record each copied tool's source path, implementation, version, and replacement policy in qps/bin/_index.qps";
product- "The local toolchain is reproducible and understandable by another agent";
state- "waiting";
);

step_4: (
goal- "Put qps/bin ahead of host utilities only inside CE-OS-controlled execution contexts";
product- "OperatorShell and QPS semantic tools can use CE-OS copies while the surrounding Android or Ubuntu environment remains untouched";
state- "waiting";
);

step_5: (
goal- "Prove copied tools behave identically before applying CE-OS-specific changes";
product- "Any later behavioral difference is intentional rather than an accidental consequence of copying";
state- "waiting";
);

step_6: (
goal- "Introduce CE-OS-specific behavior only where semantic tools require it";
product- "rg, grep, sed, or other owned mechanisms may evolve underneath probe, scope, scout, and mutation tools without changing their public semantic contract";
state- "waiting";
);

);

next- "Build gawk from acquired source with quiet progress and prove source-built awk parity against the host reference, then continue through diffutils and patch before promoting source-built outputs into qps/bin/native";

done_when: (
condition_1- "The regularly used command substrate exists under qps/bin/native";
condition_2- "Host commands remain unchanged";
