task_6: (
identity- "bin.qps_file_operations";
summary- "Add QPS-aware terminal commands for safe file validation, reference discovery, relocation, and mutation";
state- "complete";

product- "Agents and operators can use small QPS-aware terminal commands for routine .qps repository file operations without composing large ad-hoc shell scripts";

purpose: (
validation- "Validate a QPS file through the canonical runtime/check surface";
reference_discovery- "Find exact repository references to a QPS path or authority file";
relocation- "Safely relocate a .qps file whether the source is tracked or currently untracked";
reference_mutation- "Repoint exact repository references after relocation without blind broad string rewriting";
stale_detection- "Verify that stale exact references to the old path are absent or report the remaining evidence";
post_mutation_proof- "Validate affected .qps authority/index files and run git diff --check after mutations";
reporting- "Report exactly what changed, which proof commands ran, and what remains unresolved";
);

ownership: (
implementation_primary- "qps/bin";
tests- "qps/bin/tests";
index_authority- "qps/bin/_index.qps";
checklist_authority- "qps/bin/checklist.qps";
terminal_tooling_task- true;
cipher_task- false;
parser_runtime_language_semantics_task- false;
);

boundaries: (
primary_surface- "Work primarily under qps/bin and its tests, checklist, and index surfaces";
language_semantics- "Preserve existing QPS language semantics";
cpp_boundary- "Do not modify qps/cpp parser or runtime semantics unless a concrete terminal-tooling requirement proves such a change is unavoidable";
cipher_boundary- "Do not modify qps/cipher translation semantics";
syntax_boundary- "Do not redefine QPS syntax";
gear_boundary- "Do not take ownership of qps/qps/checklist.qps cipher.foreign_and_structured_semantics";
worktree_boundary- "Preserve unrelated worktree changes and do not stage, commit, save, reset, clean, or discard unrelated modifications";
ambiguity_policy- "Fail explicitly rather than guessing when repository authority or mutation targets are ambiguous";
);

command_design: (
surface- "qps check <file.qps>, qps refs [--absent] <path>, and qps move <old.qps> <new.qps>";
implementation_policy- "Reuse existing qps/bin Python command conventions and keep any qps CLI exposure as a thin terminal-tooling dispatch";
not_a_wrapper- "Do not simply wrap a huge shell script; the command must own small bounded operations and clear evidence";
exactness- "Reference mutation updates exact repo-relative old-path references with token boundaries plus exact whole string-literal file references in _index.qps, and reports any remaining stale evidence";
tracked_state- "Relocation must distinguish tracked and untracked sources because untracked files cannot be moved with git mv";
stage_policy- "The command must not stage changes";
);

steps: (

step_1: (
goal- "Inspect existing qps/bin terminal architecture and qps CLI command exposure";
product- "The new commands follow current QPS terminal conventions instead of creating an unrelated framework";
state- "complete";
);

step_2: (
goal- "Implement the smallest coherent command surface for check, reference discovery, stale-reference checking, and relocation";
product- "Routine .qps file operations are available as bounded QPS-aware terminal commands";
state- "complete";
);

step_3: (
goal- "Prove tracked source relocation without staging or destroying unrelated work";
product- "A tracked .qps source can be relocated safely while unrelated worktree changes survive untouched";
state- "complete";
);

step_4: (
goal- "Prove untracked source relocation without assuming git mv is valid";
product- "An untracked .qps source can be relocated through a filesystem move with deterministic Git-state reporting";
state- "complete";
);

step_5: (
goal- "Prove missing source and existing destination failures";
product- "Unsafe or ambiguous relocation requests fail before mutation";
state- "complete";
);

step_6: (
goal- "Prove exact reference discovery, exact repointing, stale-reference detection, and similarly named string preservation";
product- "Reference mutation changes only intended path references and reports unresolved old-path evidence";
state- "complete";
);

step_7: (
goal- "Validate affected .qps authority/index files and run git diff --check after mutation";
product- "Successful mutation includes parser/runtime and whitespace evidence";
state- "complete";
);

step_8: (
goal- "Run the real language-reference relocation only after focused temporary fixtures are green";
product- "qps/language.qps becomes the canonical language/reference sheet without redesigning language authority content";
state- "complete";
);

step_9: (
goal- "Update qps/bin/_index.qps with the proven command contracts";
product- "A future model entering qps/bin can discover the file-operation commands and their safety boundaries";
state- "complete";
);

);


findings: (
finding_1- "Existing qps/bin terminal tools use small Python command surfaces, concise PASS/FAIL evidence, and QPS runtime validation rather than large shell-script wrappers";
finding_2- "The public qps binary owns subcommand dispatch, so check, refs, and move are exposed as qps commands while operation logic remains in qps/bin";
finding_3- "qps move uses filesystem rename for both tracked and untracked sources because this task must not stage and untracked files cannot use git mv";
finding_4- "Reference discovery and mutation use exact token-bounded repo-relative path matches, plus exact whole string-literal values in _index.qps that resolve to the moved path";
finding_5- "Similarly named strings such as suffixes, descendant paths, prefixed text, and non-exact prose remain unchanged";
finding_6- "The real language-reference relocation was untracked at source and succeeded only after focused temporary fixtures proved tracked and untracked behavior";
finding_7- "qps/qps/_index.qps now points to ../language.qps for the directory-wide language reference instead of owning a sibling language.qps";
);

