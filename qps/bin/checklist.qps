task_5: (
identity- "operatorshell.multiline_terminal_input";
summary- "Make Shift+Enter insert a newline without executing the current OperatorShell terminal command";
state- "active";

product- "OperatorShell supports normal multiline command composition so Bash commands, Python heredocs, QPS Inline, and future CE-OS shell source can be authored without chaining everything through &&";

ownership: (
implementation- "UI/OperatorShell";
reference_shell- "Bash/readline is current behavioral evidence, not permanent authority";
future_runtime- "The proven interaction contract is intended to become QPS-owned behavior compiled into the CE-OS C++ terminal/runtime";
working_memory- "qps/bin/checklist.qps";
documentation- "The proven terminal interaction contract belongs in the closest OperatorShell _index.qps authority";
);

behavior: (
enter- "Execute or submit the current shell command according to the active terminal application's input contract";
shift_enter- "Insert a newline into the current shell editing state without executing it";
raw_terminal- "Normal terminal applications continue receiving interactive key input through the PTY";
no_duplicate_editor- "Do not introduce a second OperatorShell command editor merely to implement multiline Bash input unless direct terminal semantics prove insufficient";
);

terminal_architecture: (
surface- "UI/OperatorShell/widgets/TerminalSurface.gd";
input_path- "_on_terminal_gui_input -> _event_to_sequence -> TerminalClient.write_input";
display- "RichTextLabel is a rendered PTY screen, not an editable command buffer";
echo- "Typed characters are sent to the PTY and become visible only when terminal output is read back and rendered";
service- "Agency/Core/runtime/terminal/pty_service.py";
service_write- "write_input accepts arbitrary UTF-8 strings and writes them directly to the PTY master";
session_process- "The PTY service tracks the original interactive Bash process and PTY master but does not currently track foreground child process groups";
);

reference_behavior: (
readline_mode- "Current Bash runs with readline emacs mode enabled";
accept_line- "Readline binds accept-line to Ctrl+J and Ctrl+M";
quoted_insert- "Readline exposes quoted-insert through Ctrl+Q, Ctrl+V, and Escape-[2~ at the readline layer";
ui_boundary- "Physical Ctrl+V is consumed as paste by the terminal/UI path, demonstrating that terminal key events and readline byte bindings are different layers";
goal- "Determine a distinct Shift+Enter terminal sequence and shell/editor behavior that inserts a newline without accepting the command";
);

relationship_to_qps_inline: (
dependency- "QPS Inline should inherit the same terminal multiline behavior rather than inventing a separate multiline-entry mechanism";
surface- "[< code]";
single_and_multiline- "One-line and multiline QPS Inline use the same syntax; Shift+Enter only controls terminal editing, not QPS grammar";
);

current: (
item_1- "TerminalSurface currently forwards each key event directly to the active PTY session";
item_2- "Plain Enter is translated to newline and therefore submits the Bash/readline command";
item_3- "There is no OperatorShell-owned editable terminal command buffer";
item_4- "The PTY service already accepts arbitrary input strings and does not need modification merely to carry multiline source";
item_5- "A manual Ctrl+V then Ctrl+J attempt executed instead of inserting a usable newline because the UI treats Ctrl+V as paste before readline receives the quoted-insert byte";
item_6- "Bash/readline remains useful as a behavioral reference while CE-OS is being built from the foundation and later Ciphered into QPS/C++";
);

documentation: (
required- true;
authority- "UI/OperatorShell/_index.qps";
goal- "Document the proven Enter/Shift+Enter terminal contract, raw PTY boundary, and eventual CE-OS ownership after the implementation is proven";
state- "waiting";
);

