#!/usr/bin/env python3
from __future__ import annotations

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from Agency.GeminiGo.daemon import run_cycle
from Agency.GeminiGo.state import append_event, load_state, save_state
from Agency.GeminiGo.status import DEFAULT_SESSION, render, snapshot


def usage() -> int:
    print(
        "Usage: qps GeminiGo "
        "<check|thing 1|thing 2|work|wake|sleep|status --json>",
        file=sys.stderr,
    )
    return 1


def main(argv: list[str]) -> int:
    if not argv:
        return usage()

    command = argv[0].lower()

    if command == "check" and len(argv) == 1:
        print(render(snapshot()))
        return 0

    if command == "thing" and len(argv) == 2 and argv[1] in {"1", "2"}:
        data = snapshot()[f"thing_{argv[1]}"]
        print(json.dumps(data, indent=2))
        return 0

    if command == "work" and len(argv) == 1:
        data = snapshot()
        print(json.dumps({
            "assignment": data["assignment"],
            "worker": data["worker"],
            "stop_reason": data["stop_reason"],
            "sleep_reason": data["sleep_reason"],
            "work_packet_id": data["work_packet_id"],
            "last_purpose": data["last_purpose"],
            "last_updated": data["last_updated"],
        }, indent=2))
        return 0

    if command == "status" and argv[1:] == ["--json"]:
        print(json.dumps(snapshot(), indent=2))
        return 0

    if command == "wake" and len(argv) == 1:
        state = load_state(DEFAULT_SESSION)
        state["session_status"] = "idle"
        state["stop_reason"] = None
        state["sleep_reason"] = "operator_wake"
        state["last_wake_quota_day"] = None
        state["last_action_fingerprint"] = None
        state["repeated_action_count"] = 0
        save_state(DEFAULT_SESSION, state)
        append_event(DEFAULT_SESSION, "operator_wake")
        print(json.dumps(run_cycle(session_id=DEFAULT_SESSION), indent=2))
        return 0

    if command == "sleep" and len(argv) == 1:
        state = load_state(DEFAULT_SESSION)
        state["session_status"] = "stopped"
        state["stop_reason"] = "OPERATOR_SLEEP"
        state["sleep_reason"] = "operator_sleep"
        save_state(DEFAULT_SESSION, state)
        append_event(DEFAULT_SESSION, "operator_sleep")
        print("GeminiGo provider activity suppressed.")
        return 0

    return usage()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
