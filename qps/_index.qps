QPS.

purpose: def"
Canonical semantic doorway into the Quick Parse Standard subsystem.
";

surface: (
qps- "qps/qps";
cpp- "qps/cpp";
docs- "qps/qps/docs";
);

doors: (
language- "qps/qps";
native- "qps/cpp";
documentation- "qps/qps/docs";
);

documents: (
quicksheet- "qps/qps/docs/QPS.qps";
checklist- "qps/qps/docs/CHECKLIST.md";
readme- "qps/qps/docs/README.md";
execution_handoff- "qps/qps/docs/EXECUTION_HANDOFF.qps";
);

operations: (
build- "qps build";
build_authority- "qps/qps/build.qps";
cipher- "qps cipher <source> [--report]";
cipher_authority- "qps/qps/cipher.qps";
test_all- "ctest --test-dir qps/cpp/build-pixel --output-on-failure";
test_qps_surface- "qps test path/file-or-folder";
check_qps_file- "qps path/file.qps --check";
query_qps- "qps path/file.qps --get path.to.value";
);

rules: (
local_context_first- "read this index when entering qps";
language_reference- "read qps/qps/docs/QPS.qps for canonical language syntax";
work_status- "read qps/qps/docs/CHECKLIST.md for current implementation status";
qps_authority- "QPS-authored orchestration and semantic authority live under qps/qps";
native_boundary- "qps/cpp is the native substrate and current kernel-discovery quarry";
kernel_discovery- "probe native code to discover the irreducible kernel; do not assume its implementation language";
do_not_duplicate- "grammar and runtime details belong to their owning files, not this index";
);
