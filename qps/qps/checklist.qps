latest_proven- "QPS now proves canonical complete Item references, full-expression Item values, Term-owned executable body parsing as term: {...};, a neutral reusable-execution runtime registry, and an authored qps checklist workflow whose ephemeral global index and exact task lookup are implemented in QPS rather than native policy";

latest_next_experiment- "Register a TermDeclarationNode containing one ExecutionBlockNode into the already-neutral reusable execution registry, prove canonical kinetic_energy: {...}; instantiation without weakening historical compatibility, then return directly to Cipher lowering";

quarry_1- "dif: reversible difference between two identified states";

quarry_2- "real Checklist observations for repository, build, staged intent, transaction state, and machine state";

quarry_3- "persistent resumable work state that an agent can parse without prior conversation context";

quarry_4- "Moved to qps/checklist.qps: native runtime and kernel boundary";

quarry_5- "general multi-source execution-definition resolution for authored QPS authorities";

continuation_rule- "A development session should be resumable from authored repository state without requiring prior chat history";

agent_rule- "Agents may leave notes, hypotheses, failures, and next experiments in authored project state, but notes never satisfy proof requirements";

evidence_rule- "Reality produces observations; authored QPS decides what supplied observations mean";

dif_rule- "A dif represents a reversible structural difference between two identified states and should traverse QPS identity rather than inherit Git byte-diff semantics";

git_rule- "Keep Git operationally for now as the proven substrate for status, commit, and byte-level diff";

save_rule- "Future CE-OS save may replace the human-facing role of git commit while remaining backed by Git until a native replacement is proven";

history_rule- "CE-OS History is the single repository-root semantic ledger of accepted transitions; qps history <path> queries that ledger by recorded repository scope while _index.qps remains current-truth authority";

separation_rule- "Git diff observes byte-level repository change; QPS dif is a parser-aware reversible transition across identified structure";

cipher_goal- "Convert complete source dependency closures into validated QPS without publishing partial conversion state";

cipher_authority- "qps/qps/cipher.qps";

cipher_frontend_state- "PROVEN: Python local dependency recursion, foreign dependency classification, merged local IR, reference-valued parameter defaults, executable QPS emission for the first Engineering numeric function slice, QPS validation, and QPS runtime execution";

cipher_source_families- "Current loaders recognize Python, C++, C/C++ headers, JSON, YAML, and YML; recognition is not equivalent to complete semantic convertibility";

cipher_preflight_command- "qps cipher test <input> [output]";

cipher_preflight_rule- "Preflight must traverse the same complete source and dependency graph as conversion, attempt the same translation path, validate all candidate QPS, report every blocker, and write no destination output";

cipher_atomic_rule- "A real Cipher conversion must complete discovery, dependency classification, translation, and validation before publishing destination output";

cipher_failure_rule- "If any required source, dependency, construct, generated QPS document, or destination condition blocks the requested conversion, publish none of that conversion transaction";

cipher_complete_graph_rule- "Cipher must determine the complete required conversion set before publication rather than discovering dependencies incrementally while writing";

cipher_local_dependency_rule- "Dependencies resolving inside the CE-OS workspace are local source dependencies and are recursively absorbed into the compilation closure";

cipher_foreign_dependency_rule- "Dependencies that do not resolve inside the CE-OS workspace remain foreign provenance; future external-library representation belongs at the qps/libs boundary and may use a dedicated ^ surface once that grammar is proven";

cipher_alias_rule- "Source aliases survive dependency resolution as local symbol bindings even when local import statements disappear from consolidated QPS";

cipher_consolidation_rule- "Local source path topology is compilation-time provenance; a consolidated QPS artifact may remove local import traversal after identities and references are resolved";

cipher_publish_rule- "Directory conversion stages the complete candidate output separately, validates the staged set, then publishes only the complete validated set";

cipher_library_root- "qps/libs";

cipher_library_index_rule- "Every Cipher-created directory beneath qps/libs must contain _index.qps before publication";

cipher_library_namespace_rule- "External source namespace topology is preserved beneath qps/libs rather than flattened";

cipher_library_python_rule- "Python imports map beneath qps/libs/Python using their canonical package/module path";

cipher_library_symbol_rule- "Cipher demand-populates only required canonical symbols and their required dependency closure";

cipher_library_dedup_rule- "If a canonical library symbol is already indexed, later conversions reuse it rather than create another copy";

cipher_library_alias_rule- "Source aliases remain local bindings and never create duplicate library identities";

cipher_library_transaction_rule- "Library additions, parent-index changes, and consuming QPS outputs must validate and publish as one Cipher transaction";

cipher_library_resolution_states- "local, library-resolved, library-missing, unresolved";

cipher_library_next- "Implement indexed library lookup before teaching Cipher to populate missing foreign symbols";

cipher_next- "PAUSED: resume Cipher preflight and atomic publication after Checklist, Save, and History semantics are established";

history_goal- "Make accepted CE-OS accomplishments immediately discoverable by repository location without requiring Git-log interpretation or prior conversation context";

history_ledger- "~/ce-os/history.qps";

history_authority_rule- "The root history.qps is the single authoritative CE-OS semantic history ledger; directory-local history is a filtered view rather than duplicated history files";

history_storage_rule- "History records accepted semantic accomplishments, capabilities, important discoveries, remaining limitations, proof references, and source Checklist identity rather than reproducing byte-level commit history";

history_entry_rule- "One history entry represents one meaningful accepted task or capability transition, not every edit, command, probe, or intermediate failure";

history_identity_rule- "Each history entry has a stable semantic identity in addition to its timestamp";

history_timestamp_rule- "Each accepted entry records an explicit machine-readable timestamp while its structural QPS key may use a grammar-safe timestamp-derived identity";

history_scope_rule- "Each history entry records one or more repository scopes describing where the accepted accomplishment belongs";

history_multiscope_rule- "A history entry may belong to multiple repository scopes when one accepted task crosses subsystem boundaries";

history_query_command- "qps history <path>";

history_query_rule- "qps history <path> returns concise accepted history whose recorded scope belongs to that requested repository section";

history_locality_rule- "A scoped history query must not dump unrelated parent, sibling, or repository-wide history";

history_root_rule- "qps history with no path returns the root CE-OS history view";

history_concise_rule- "Default history output contains timestamp, semantic identity, and concise summary only";

history_detail_rule- "Detailed meaning, proof, relevant files, remaining limitations, source Checklist, and backing state are loaded only when explicitly requested";

history_full_command- "qps history <path> --full";

history_identity_command- "qps history --id <history_identity>";

history_evidence_rule- "Default history queries do not recursively load Checklist evidence or implementation files; detailed investigation follows the recorded source Checklist or relevant paths";

history_scope_derivation_rule- "qps save derives history scope from the accepted Checklist's predetermined relevant and ownership fields rather than requiring manual history authoring";

history_structure_rule- "Repository directory topology remains the primary navigation model; history uses that same topology as an index into one root semantic ledger";

save_command- "qps save <checklist.qps>";

save_source_rule- "The completed Checklist is the authoritative source from which Save constructs a normalized history entry";

save_history_ready_rule- "Save proceeds only when the Checklist contains an explicit authored state declaring that it is ready for history";

save_no_guess_rule- "qps save never infers completion from prose, working-tree appearance, or agent judgment when the authored readiness state is absent";

save_required_fields_rule- "A history-ready Checklist supplies predetermined fields sufficient to derive identity, summary, meaning, proof state, relevant scope, remaining limitations, and source Checklist reference";

save_normalization_rule- "Save transforms the Checklist's predetermined accepted fields into the canonical history entry schema automatically";

save_backlink_rule- "Every generated history entry records the source Checklist path so concise history may be expanded into its complete proof trail";

save_duplicate_rule- "The same accepted Checklist state must not produce duplicate history entries";

save_atomic_rule- "History publication is atomic: either the complete normalized entry is accepted into history.qps or history remains unchanged";

save_git_rule- "Git remains an optional backing identity and byte-level substrate; semantic history is authoritative for what CE-OS accomplished";

save_completion_rule- "After successful history publication, the Checklist records the resulting history identity and saved state so subsequent work may advance without rewriting the historical record";

history_schema_v1- "timestamp, identity, scope, summary, meaning, proof, relevant, remaining, source_checklist, backing_state";

history_benefit- "An agent entering any CE-OS subsystem can first request concise local history, learn what that subsystem already accomplished, and load deeper evidence only when needed";

history_next- "Keep the root history.qps ledger structurally queryable by repository scope while authored Save becomes the only operation that appends accepted task transitions";

checklist_cli_goal- "Provide a concise freshly resolved terminal index of CE-OS Checklist work across the connected QPS module web";

checklist_cli_command- "qps checklist";

checklist_cli_checklist_command- "qps checklist <checklist-index>";

checklist_cli_task_command- "qps checklist <checklist-index> <task-number>";

checklist_cli_discovery_rule- "Every invocation discovers reachable checklist.qps files through the connected QPS module web and regenerates the ephemeral Checklist index from current repository structure";

checklist_cli_index_rule- "Checklist numbers are ephemeral navigation shortcuts created by the current invocation; they are not authored or persisted identity";

checklist_cli_identity_rule- "Permanent Checklist identity remains its repository path and authored semantic contents; permanent task identity remains its authored task_N identity and semantic identity";

checklist_cli_numbering_rule- "Every discovered checklist.qps consumes one Checklist index number in deterministic discovery order, including a Checklist with no canonical current_work.tasks surface";

checklist_cli_default_rule- "qps checklist prints the freshly generated global Checklist index and only terminal-visible unfinished tasks for each discovered Checklist";

checklist_cli_done_rule- "A discovered Checklist with zero terminal-visible unfinished tasks is rendered as DONE while retaining its ephemeral Checklist number";

checklist_cli_selection_rule- "qps checklist <checklist-index> reruns discovery and resolves that number against the newly generated current index rather than consulting persisted numbering";

checklist_cli_task_selection_rule- "qps checklist <checklist-index> <task-number> reruns discovery, resolves the current Checklist number, and selects the authored task_N matching the requested task number";

checklist_cli_output_rule- "Task output includes ephemeral Checklist and authored task identity, exact structural line count, source path, semantic identity, and concise summary; exact task selection also includes start-end source coordinates";

checklist_cli_noise_rule- "Default Checklist output does not print proof evidence, completed work, historical entries, implementation detail, or unrelated Checklist structure";

checklist_task_surface_rule- "Each Checklist should expose a small canonical current_work task surface that terminal tooling can inspect without understanding the Checklist's full custom proof logic";

checklist_task_state_active- "active";

checklist_task_state_waiting- "waiting";

checklist_task_state_blocked- "blocked";

checklist_task_state_ready- "ready";

checklist_task_state_complete- "complete";

checklist_task_state_saved- "saved";

checklist_task_default_visible_states- "active, waiting, blocked, ready, complete";

checklist_task_hidden_states- "saved";

checklist_task_identity_rule- "Each task has an authored task_N structural identity and a stable semantic identity distinct from its human-readable summary";

checklist_task_summary_rule- "Each active task has a concise terminal-facing summary suitable for qps checklist output";

checklist_task_state_rule- "Task state is explicit authored data; qps checklist does not infer task completeness from Git state, file changes, prose, or agent judgment";

checklist_save_transition_rule- "A completed history-ready task may become saved only after qps save successfully publishes its normalized history entry";

checklist_history_transition_rule- "Complete work remains visible as unsaved work; only successful qps save transitions accepted work to saved, after which it disappears from qps checklist and remains discoverable through qps history";

checklist_git_distinction- "Git status answers which files changed; qps checklist answers what CE-OS is currently trying to accomplish";

checklist_agent_entry_rule- "An agent entering CE-OS should run qps checklist first to obtain the freshly resolved repository-wide semantic work index";

checklist_current_task_example- "current_work task entries use task_N: ( identity- ...; summary- ...; state- ...; )";

checklist_next- "Checklist discovery, ephemeral numbering, DONE rendering, visible-task rendering, Checklist selection, and exact authored task selection are implemented in qps/qps/checklist.qps; native code provides only generic substrate and thin CLI dispatch";

git_quarry: (
state- "Scoped enough to separate Git mechanism from CE-OS semantics";

working_tree- "Physical current repository state";

index- "Git stores a selected candidate tree between HEAD and working state; do not copy the index format into QPS unless later evidence requires it";

tree_identity- "A Git tree gives exact content identity for a complete saved filesystem state";

commit_identity- "A Git commit identifies a tree and connects it to a parent with metadata";

diff_observation- "Git diff is retained as byte-level change evidence";

save_direction- "CE-OS save should mean identifying and accepting a proven state; git commit remains the backing mechanism for now";

history_direction- "CE-OS history should expose saved-state identity and current divergence; git status and log remain backing mechanisms for now";

dif_direction- "QPS dif is independent of Git diff and should represent a reversible parser-aware structural difference between identified states";

staging_direction- "Do not reproduce Git staging mechanically; first determine whether Checklist plus dif already represent intended candidate state";

connected_execution_environment- "Proven: existing PathResolver, DocumentStore, and ExecutionEngine primitives are sufficient to execute definitions composed across multiple connected QPS documents while preserving source identity";

connected_execution_implication- "No import/include syntax or new execution-language primitive is required for multi-document execution";

connected_execution_remaining- "Resolved: general ExecutionEnvironment assembly loads immediate documents from an already-selected connected QPS module and registers reusable definitions with source identity";

connected_source_cli- "Proven: direct source execution can load sibling authored definitions through connected module topology while executing only the selected entry Program";

qps_language_module- "qps/qps/_index.qps establishes the authored QPS language surface as a connected module; checklist_run.qps can compose Checklist_Evidence and Checklist without import/include syntax";

kernel_implication- "Multi-document authored execution requires no new QPS language primitive; native responsibility is reduced to module/path mechanism, document loading and lifetime, parsing, and runtime execution";

next- "Probe, scope, and scout are proven; native execution-environment and kernel continuation remains tracked in qps/checklist.qps";
);

QPS_TOOL_TRIO.

status- "PROVEN";

probe: (
purpose- "Inspect an exact known physical or authored location";
physical- "Arbitrary files may be inspected by source line and radius";
qps- "QPS documents may be selected through exact structural paths";
output- "Shared SourceSpan renderer";
);

scope: (
purpose- "Inspect the immediate authored structural neighborhood of an exact QPS structural path";
selection- "Existing structural path selection";
members- "Immediate authored members only";
item_behavior- "Items are valid structural leaves with no child scope";
filesystem_recursion- "NO";
output- "Shared SourceSpan renderer";
);

scout: (
purpose- "Discover exact authored identities within one indexed QPS module";
module_boundary- "_index.qps";
documents- "Immediate qpsFiles only; _index.qps itself excluded";
child_module_descent- "NO";
filesystem_recursion- "NO";
document_ast_recursion- "YES";
matching- "Exact AST-authored identity, not textual grep";
identity_surface- "Key, Term, Item, and named ExecutionDefinition";
broken_document_behavior- "Parser-incompatible sibling documents are isolated so valid evidence from readable documents remains available";
output- "Shared SourceSpan renderer";
);

source_output: (
header- "path:start-end";
body- "ln: source";
deduplication- "Physical source ranges normalize and merge";
semantic_path_stacking- "NO";
);

continuation- "Use scout to discover, scope to inspect neighborhood, and probe to inspect exact evidence";


{Checklist_Render:
[>path-]
[>checklist_index-]

document: -qps_load(
path- path;
);

current_work: -structure_child(
structure- document;
name- "current_work";
);

tasks: -structure_child(
structure- current_work;
name- "tasks";
);

task_list: -structure_children(
structure- tasks;
);

task_count: -sequence_size(
value- task_list;
);

[>task_index-] 0;

-while task_index < task_count {
task: -sequence_at(
value- task_list;
index- task_index;
);

task_name: -structure_name(
structure- task;
);

identity_item: -structure_item(
structure- task;
name- "identity";
);

identity: -structure_value(
structure- identity_item;
);

summary_item: -structure_item(
structure- task;
name- "summary";
);

summary: -structure_value(
structure- summary_item;
);

state_item: -structure_item(
structure- task;
name- "state";
);

state: -structure_value(
structure- state_item;
);

%visible: 0

-if state == "active" {
[>visible-] 1;
}

-if state == "waiting" {
[>visible-] 1;
}

-if state == "blocked" {
[>visible-] 1;
}

-if state == "ready" {
[>visible-] 1;
}

-if state == "complete" {
[>visible-] 1;
}

-if visible == 1 {
start_line: -structure_start(
structure- task;
);

end_line: -structure_end(
structure- task;
);

%line_count: end_line - start_line + 1

-write(
stream- "stdout";
value- checklist_index;
);

-write(
stream- "stdout";
value- ".";
);

-write(
stream- "stdout";
value- task_name;
);

-write(
stream- "stdout";
value- "   ";
);

-write(
stream- "stdout";
value- state;
);

-write(
stream- "stdout";
value- "   ";
);

-write(
stream- "stdout";
value- line_count;
);

-write(
stream- "stdout";
value- " ln   ";
);

-write(
stream- "stdout";
value- path;
);

-write(
stream- "stdout";
value- "\n    ";
);

-write(
stream- "stdout";
value- identity;
);

-write(
stream- "stdout";
value- "\n    ";
);

-write(
stream- "stdout";
value- summary;
);

-write(
stream- "stdout";
value- "\n";
);
}

[>task_index-] task_index + 1;
}

-return 0;
}


{Checklist_Index:
[>root-]
[>module-]
[>checklist_index-]
[>target_checklist-] 0;
[>target_task-] "";

files: -module_files(
root- root;
module- module;
);

file_count: -sequence_size(
value- files;
);

[>file_index-] 0;

-if module == "" {
[>expected_checklist-] "checklist.qps";
}
-else {
[>expected_checklist-] module + "/checklist.qps";
}

-while file_index < file_count {
file: -sequence_at(
value- files;
index- file_index;
);

-if file == expected_checklist {
%has_visible: {>Checklist_Has_Visible_Tasks:
path- file;
}

%selected: 0

-if target_checklist == 0 {
[>selected-] 1;
}

-if target_checklist == checklist_index {
[>selected-] 1;
}

-if selected == 1 {
-if has_visible == 1 {
-if target_task == "" {
%render_result: {>Checklist_Render:
path- file;
checklist_index- checklist_index;
}
}
-else {
%render_result: {>Checklist_Render_Selected:
path- file;
checklist_index- checklist_index;
task_name- target_task;
}
}
}
-else {
-write(
stream- "stdout";
value- checklist_index;
);

-write(
stream- "stdout";
value- "   DONE   ";
);

-write(
stream- "stdout";
value- file;
);

-write(
stream- "stdout";
value- "\n";
);
}
}

[>checklist_index-] checklist_index + 1;
}

[>file_index-] file_index + 1;
}

children: -module_children(
root- root;
module- module;
);

child_count: -sequence_size(
value- children;
);

[>child_index-] 0;

-while child_index < child_count {
child: -sequence_at(
value- children;
index- child_index;
);

%next_index: {>Checklist_Index:
root- root;
module- child;
checklist_index- checklist_index;
target_checklist- target_checklist;
target_task- target_task;
}

[>checklist_index-] next_index;
[>child_index-] child_index + 1;
}

-return checklist_index;
}


{Checklist_Resolve_Path:
[>root-]
[>module-]
[>checklist_index-]
[>target_checklist-]

[>found_path-] "";

files: -module_files(
root- root;
module- module;
);

file_count: -sequence_size(
value- files;
);

[>file_index-] 0;

-if module == "" {
[>expected_checklist-] "checklist.qps";
}
-else {
[>expected_checklist-] module + "/checklist.qps";
}

-while file_index < file_count {
file: -sequence_at(
value- files;
index- file_index;
);

-if file == expected_checklist {
-if checklist_index == target_checklist {
[>found_path-] file;
}

[>checklist_index-] checklist_index + 1;
}

[>file_index-] file_index + 1;
}

-if found_path == "" {
children: -module_children(
root- root;
module- module;
);

child_count: -sequence_size(
value- children;
);

[>child_index-] 0;

-while child_index < child_count {
child: -sequence_at(
value- children;
index- child_index;
);

%child_result: {>Checklist_Resolve_Path:
root- root;
module- child;
checklist_index- checklist_index;
target_checklist- target_checklist;
}

child_path: -dictionary_at(
value- child_result;
index- 0;
);

child_next_index: -dictionary_at(
value- child_result;
index- 1;
);

[>checklist_index-] child_next_index;

-if child_path == "" {
[>found_path-] found_path;
}
-else {
[>found_path-] child_path;
}

[>child_index-] child_index + 1;
}
}

-return [
1: found_path,
2: checklist_index
];;
}


{Checklist_Path:
[>root-]
[>checklist_index-]

%result: {>Checklist_Resolve_Path:
root- root;
module- "";
checklist_index- 1;
target_checklist- checklist_index;
}

path: -dictionary_at(
value- result;
index- 0;
);

-if path == "" {
-assert 0 == 1;
}

-return path;
}


{Checklist_List:
[>root-]

%next_index: {>Checklist_Index:
root- root;
module- "";
checklist_index- 1;
target_checklist- 0;
target_task- "";
}

-return next_index;
}


{Checklist_Has_Tasks:
[>path-]

document: -qps_load(
path- path;
);

root_children: -structure_children(
structure- document;
);

root_count: -sequence_size(
value- root_children;
);

[>root_index-] 0;
[>has_tasks-] 0;

-while root_index < root_count {
root_child: -sequence_at(
value- root_children;
index- root_index;
);

root_name: -structure_name(
structure- root_child;
);

-if root_name == "current_work" {
work_children: -structure_children(
structure- root_child;
);

work_count: -sequence_size(
value- work_children;
);

[>work_index-] 0;

-while work_index < work_count {
work_child: -sequence_at(
value- work_children;
index- work_index;
);

work_name: -structure_name(
structure- work_child;
);

-if work_name == "tasks" {
[>has_tasks-] 1;
}

[>work_index-] work_index + 1;
}
}

[>root_index-] root_index + 1;
}

-return has_tasks;
}


{Checklist_Render_Selected:
[>path-]
[>checklist_index-]
[>task_name-]

document: -qps_load(
path- path;
);

current_work: -structure_child(
structure- document;
name- "current_work";
);

tasks: -structure_child(
structure- current_work;
name- "tasks";
);

task: -structure_child(
structure- tasks;
name- task_name;
);

start_line: -structure_start(
structure- task;
);

end_line: -structure_end(
structure- task;
);

source: -file_span(
path- path;
start- start_line;
end- end_line;
);

-write(
stream- "stdout";
value- checklist_index;
);

-write(
stream- "stdout";
value- ".";
);

-write(
stream- "stdout";
value- task_name;
);

-write(
stream- "stdout";
value- "   ";
);

-write(
stream- "stdout";
value- path;
);

-write(
stream- "stdout";
value- ":";
);

-write(
stream- "stdout";
value- start_line;
);

-write(
stream- "stdout";
value- "-";
);

-write(
stream- "stdout";
value- end_line;
);

-write(
stream- "stdout";
value- "\n\n";
);

-write(
stream- "stdout";
value- source;
);

-write(
stream- "stdout";
value- "\n";
);

-return 0;
}

{Checklist_Show:
[>root-]
[>checklist_index-]

%next_index: {>Checklist_Index:
root- root;
module- "";
checklist_index- 1;
target_checklist- checklist_index;
target_task- "";
}

-return next_index;
}


{Checklist_Show_Task:
[>root-]
[>checklist_index-]
[>task_name-]

%next_index: {>Checklist_Index:
root- root;
module- "";
checklist_index- 1;
target_checklist- checklist_index;
target_task- task_name;
}

-return next_index;
}


{Checklist_Has_Visible_Tasks:
[>path-]

document: -qps_load(
path- path;
);

root_children: -structure_children(
structure- document;
);

root_count: -sequence_size(
value- root_children;
);

[>root_index-] 0;
[>has_visible-] 0;

-while root_index < root_count {
root_child: -sequence_at(
value- root_children;
index- root_index;
);

root_name: -structure_name(
structure- root_child;
);

-if root_name == "current_work" {
work_children: -structure_children(
structure- root_child;
);

work_count: -sequence_size(
value- work_children;
);

[>work_index-] 0;

-while work_index < work_count {
work_child: -sequence_at(
value- work_children;
index- work_index;
);

work_name: -structure_name(
structure- work_child;
);

-if work_name == "tasks" {
task_list: -structure_children(
structure- work_child;
);

task_count: -sequence_size(
value- task_list;
);

[>task_index-] 0;

-while task_index < task_count {
task: -sequence_at(
value- task_list;
index- task_index;
);

state_item: -structure_item(
structure- task;
name- "state";
);

state: -structure_value(
structure- state_item;
);

-if state == "active" {
[>has_visible-] 1;
}

-if state == "waiting" {
[>has_visible-] 1;
}

-if state == "blocked" {
[>has_visible-] 1;
}

-if state == "ready" {
[>has_visible-] 1;
}

-if state == "complete" {
[>has_visible-] 1;
}

[>task_index-] task_index + 1;
}
}

[>work_index-] work_index + 1;
}
}

[>root_index-] root_index + 1;
}

-return has_visible;
}
