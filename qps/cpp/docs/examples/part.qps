# part.grav
alt. (Alternator: def"
An alternator is a device that turns angular momentum into AC Electricity. (ME = AC);),
(input: mv-/n;, rpm-/n;),
(output: vac-/n;, hz-/n;),
(dimensions:
(master:
(pulley: radius-/n;, width-/n;, depth-/n;, material-/n;),
(gear: radius-/n;, width-/n;, teeth count-/n;, teeth depth-/n;, (material-/a;, density-/n;))),
(housing: outside diameter-/n;, inside diameter-/n;, length-/n;, (material-/a;, density-/n;)),
(stator: poles/n;, windings/n;, (coil material/a;, density/n;),
(rotor: poles-/n;, windings-/n;, shaft radius-/n;, (material-/a;, density-/n;)))),
(equation: {output:});

