# part.grav
alt.
(Alternator:def"An alternator is a device that turns angular momentum into AC Electricity. (ME = AC)";,
input:(mv-/n;,rpm-/n;),
output:(vac-/n;,hz-/n;),
dimensions:
(master: # Term: 'master' - Its content is a list of terms/containers, not directly in ().
pulley:(radius-/n;,width-/n;,depth-/n;,material-/n;), # Term: 'pulley' - Content is a container of Items.
gear:(radius-/n;,width-/n;,teeth_count-/n;,teeth_depth-/n;,(material-/a;,density-/n;)), # Term: 'gear' - Content is a container.
housing:(outside_diameter-/n;,inside_diameter-/n;,length-/n;,(material-/a;,density-/n;)), # Term: 'housing' - Content is a container.
stator:((type: coil_material-/a;,density-/n;),poles-/n;,windings-/n;), # Term: 'stator' - Content is a list of container and items.
rotor:(poles-/n;,windings-/n;,shaft_radius-/n;,(material-/a;,density-/n;))), # Term: 'rotor' - Content is a container.
equation:{#output:0/n;_});
; # This final semicolon terminates the entire 'alt.' Key declaration.