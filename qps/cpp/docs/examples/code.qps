# code.grav

# Declare your index reference
index1: path/to/my_library/{index}/p; # Example: 'path/to/my_library/index.grav'
data_from_library: index1.key.term:item-value/n;/p;

# Declare your function
-func my_processing_function. {
-print "Processing data: data_from_library/n_
-let processed_result: {#output: data_from_library * 2/n;}_
-return [result: processed_result]_
};

{
-print "Starting pipeline."_
-let result: my_processing_function._ # Call the function
-print "Pipeline complete. Result: [>result]_
}

